---
import { presetIds } from '@heart-atlas/heart-clock';
import HeartViewer from '@heart-atlas/viewer/island';
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';
import { clockChoices } from '../../components/heart-clock/choices.ts';
import HeartClockDemo from '../../components/heart-clock/HeartClockDemo.tsx';
import {
  heartClockMessageKeys,
  type HeartClockMessages,
} from '../../components/heart-clock/messages.ts';
import { modelSources, presetSources } from '../../components/heart-clock/sources.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localeCodes } from '../../i18n/locales.ts';
import { getMessages } from '../../i18n/messages.ts';
import { localePath } from '../../i18n/paths.ts';
import {
  heartAttribution,
  heartModelUrls,
  heartStructures,
  viewerMessages,
} from '../../lib/heart-model.ts';

export const getStaticPaths = (() =>
  localeCodes.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as InferGetStaticParamsType<typeof getStaticPaths>;
const t = getMessages(locale);
const messages = Object.fromEntries(
  heartClockMessageKeys.map((key) => [key, t[key]]),
) as HeartClockMessages;

const sources = [...modelSources, ...presetSources];
const { models, poster } = heartModelUrls(import.meta.env.BASE_URL);
---

<BaseLayout locale={locale} title={t['heartClock.title']} description={t['heartClock.intro']}>
  <h1>{t['heartClock.title']}</h1>
  <p>{t['heartClock.intro']}</p>
  <p class="schematic" role="note">
    {t['heartClock.schematic']}
  </p>
  <HeartClockDemo
    client:visible
    locale={locale}
    messages={messages}
    choices={clockChoices(presetIds)}
  />
  <p>
    <a href={localePath(import.meta.env.BASE_URL, locale, 'heart-sounds/')}>
      {t['heartSounds.link']}
    </a>
  </p>
  <h2>{t['heartClock.model3d']}</h2>
  <HeartViewer
    client:visible={{ rootMargin: '200px' }}
    models={models}
    poster={poster}
    structures={heartStructures(t)}
    messages={viewerMessages(t)}
    attribution={heartAttribution()}
    loadOn="click"
    headingLevel={3}
    cycle="page"
  />
  <h2>{t['heartClock.sources']}</h2>
  <ol class="sources">
    {sources.map((source) => (
      <li>
        <a href={source.href} lang={source.lang}>
          {source.text}
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>

<style>
  .schematic {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-inline-start: 4px solid var(--color-accent);
  }

  .sources {
    padding-inline-start: 1.5rem;
    font-size: 0.875rem;
  }

  /* Short one-line links sit closer than the 24 px target spacing (WCAG 2.5.8) without a gap. */
  .sources li + li {
    margin-block-start: 0.5rem;
  }
</style>
