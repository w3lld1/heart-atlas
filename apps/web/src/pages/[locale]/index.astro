---
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';
import { getCollection } from 'astro:content';
import BodyBackdrop from '../../components/home/BodyBackdrop.astro';
import CardIcon from '../../components/home/CardIcon.astro';
import EcgStrip from '../../components/home/EcgStrip.astro';
import SectionArt from '../../components/home/SectionArt.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localeCodes, locales } from '../../i18n/locales.ts';
import { getMessages } from '../../i18n/messages.ts';
import { localePath } from '../../i18n/paths.ts';
import { formatCount } from '../../i18n/plural.ts';
import { articlePages } from '../../lib/articles.ts';
import {
  heartAttribution,
  heartModelUrls,
  heartStructures,
  heroPoster,
  structureIds,
} from '../../lib/heart-model.ts';
import { handFontCss } from '../../lib/hand-font.ts';
import { cardPath, stageCards, type SectionId } from '../../lib/home.ts';
import { repoUrl } from '../../site.ts';

export const getStaticPaths = (() =>
  localeCodes.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as InferGetStaticParamsType<typeof getStaticPaths>;
const t = getMessages(locale);
const base = import.meta.env.BASE_URL;
const href = (path = '') => localePath(base, locale, path);
const count = (key: keyof typeof t, n: number) => formatCount(t[key], locale, n);

const pages = articlePages(await getCollection('articles'), locales).filter(
  (page) => page.locale === locale,
);
// Articles written in this language; pages shown from a fallback language are not counted.
const written = pages.filter((page) => page.contentLocale === locale);
// Section notes count what a reader can open here, including articles shown in a fallback language.
const readableOf = (type: string) => pages.filter((page) => page.type === type).length;
const has = {
  article: (path: string) => written.some((page) => `${page.type}/${page.slug}` === path),
  // The anatomy page with the 3D viewer exists in every language; other sections need articles.
  section: (type: string) => type === 'anatomy' || pages.some((page) => page.type === type),
};

const poster = heroPoster();
// The hero poster and the live heart come from BodyParts3D, whose licenses require this credit.
const [creditBefore = '', creditAfter = ''] = t['viewer.attribution'].split('{source}');
const credits = heartAttribution();
const modelUrls = heartModelUrls(base);
const posterUrl = modelUrls.heroPoster;
const cards = stageCards.flatMap((card) => {
  const path = cardPath(card, has);
  const anchor = poster.anchors[card.anchor];
  if (path === null || anchor === undefined) return [];
  const note = card.id === 'disease' ? count(card.note, readableOf('disease')) : t[card.note];
  return [
    {
      ...card,
      href: href(path),
      anchorId: card.anchor,
      anchor,
      note,
      structures: structureIds(card.groups),
    },
  ];
});

interface SectionCard {
  id: SectionId;
  href: string;
  title: string;
  note: string;
}
// Disease and diagnostics cards only for languages that have those sections.
const sections: SectionCard[] = [
  {
    id: 'anatomy',
    href: href('anatomy/'),
    title: t['articles.type.anatomy'],
    note: count('home.section.anatomyNote', readableOf('anatomy')),
  },
  ...(['disease', 'diagnostic'] as const)
    .filter((type) => has.section(type))
    .map((type) => ({
      id: type,
      href: href(`${type}/`),
      title: t[`articles.type.${type}`],
      note: count(`home.section.${type}Note`, readableOf(type)),
    })),
  {
    id: 'model',
    href: href('anatomy/'),
    title: t['home.section.model'],
    note: t['home.section.modelNote'],
  },
  {
    id: 'clock',
    href: href('heart-clock/'),
    title: t['home.cta.clock'],
    note: t['home.section.clockNote'],
  },
  {
    id: 'sounds',
    href: href('heart-sounds/'),
    title: t['heartSounds.title'],
    note: t['home.section.soundsNote'],
  },
  { id: 'code', href: repoUrl, title: t['home.section.code'], note: t['home.section.codeNote'] },
];

// "Atlas <em>heart</em>": the accent word is set apart when the title contains it.
const title = t['home.title'];
const accent = t['home.titleAccent'];
const at = title.indexOf(accent);
const titleParts =
  at === -1 ? [title, '', ''] : [title.slice(0, at), accent, title.slice(at + accent.length)];
const lines = (text: string) => text.split('\n');
const handFont = await handFontCss(t['home.hand']);
const arrow = 'M5 12h14M13 6l6 6-6 6';
// What the live heart needs, read by the page script when the heart loads.
// "<" is escaped, so no text in it can close the script element it sits in.
const heroData = JSON.stringify({
  models: modelUrls.models,
  structures: heartStructures(t),
  anchors: Object.fromEntries(cards.map((card) => [card.anchorId, card.anchor])),
  posterAspect: poster.width / poster.height,
  label: t['home.heart3d'],
}).replaceAll('<', '\\u003c');
---

<BaseLayout locale={locale} wide>
  <Fragment slot="head" set:html={`<style>${handFont}</style>`} />
  <section class="hero" aria-labelledby="home-title">
    <div class="copy">
      <p class="eyebrow">{t['home.eyebrow']}</p>
      <h1 id="home-title">
        {[titleParts[0], titleParts[1] && <em>{titleParts[1]}</em>, titleParts[2]]}
      </h1>
      <p class="tagline">
        {lines(t['home.tagline']).map((line, i) => (i === 0 ? line : [<br />, line]))}
      </p>
      <p class="lead">{t['home.lead']}</p>
      <div class="ctas">
        <a class="cta primary" href={href('anatomy/')}>
          {t['home.cta.explore']}
          <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path d={arrow} />
          </svg>
        </a>
        <a class="cta ghost glass" href={href('heart-clock/')}>
          <span class="cta-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24">
              <path d="M2 12h4l2-5 4 10 3-7 2 2h5" />
            </svg>
          </span>
          <span class="cta-text">
            {t['home.cta.clock']}
            <small>{t['home.cta.clockNote']}</small>
          </span>
        </a>
      </div>
      <ul class="facts">
        <li>
          <b>{count('home.fact.articles', written.length)}</b>
          {t['home.fact.articlesNote']}
        </li>
        <li>
          <b>{localeCodes.map((code) => locales[code]?.name ?? code).join(' · ')}</b>
          {t['home.fact.languagesNote']}
        </li>
        <li>
          <b>{t['home.fact.code']}</b>
          {t['home.fact.codeNote']}
        </li>
      </ul>
    </div>

    <div class="stage" data-stage>
      <div class="backdrop">
        <BodyBackdrop />
      </div>
      <div class="glow" aria-hidden="true"></div>
      <div class="heart" data-heart>
        <img
          class="poster"
          data-poster
          src={posterUrl}
          width={poster.width}
          height={poster.height}
          alt={t['home.posterAlt']}
          fetchpriority="high"
        />
        <div class="hero-mount" data-hero-mount></div>
        <button class="load3d glass" type="button" data-load3d hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3Zm-8 4.5 8 4.5 8-4.5M12 12v9" />
          </svg>
          {t['motion.load3d']}
        </button>
      </div>
      <script type="application/json" data-hero-data set:html={heroData} />
      <svg class="links" data-links aria-hidden="true" focusable="false">
        {cards.map((card) => (
          <g class="link" data-card={card.id}>
            <line />
            <circle class="ring" r="9" />
            <circle class="halo" r="9" />
            <circle class="dot" r="4" />
            <circle class="end" r="2.5" />
          </g>
        ))}
      </svg>
      <ul class="nodes" aria-label={t['home.stage.label']}>
        {cards.map((card) => (
          <li class={`node-slot slot-${card.id}`}>
            <a
              class="node glass"
              href={card.href}
              data-card={card.id}
              data-anchor-id={card.anchorId}
              data-anchor-x={card.anchor.x}
              data-anchor-y={card.anchor.y}
              data-structures={card.structures.join(' ')}
              data-ghost={card.ghost ? '' : undefined}
            >
              <span class="node-icon">
                <CardIcon id={card.id} />
              </span>
              <span class="node-text">
                <b>{t[card.title]}</b>
                <small>{card.note}</small>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="hint glass">
        <svg width="34" height="18" viewBox="0 0 34 18" aria-hidden="true">
          <path d="M0 10h8l2-5 3 10 3-13 3 11 2-3h13" />
        </svg>
        <span class="tags">{t['home.stage.tags']}</span>
        <span class="hint-text">{t['home.stage.hint']}</span>
      </p>
    </div>

    <aside class="side">
      <p class="hand">{t['home.hand']}</p>
      <EcgStrip />
      <p class="side-text">{t['home.side.text']}</p>
      <p class="world">
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <circle cx="20" cy="20" r="17" class="world-fill" />
          <circle cx="20" cy="20" r="17" />
          <path d="M8 14c4 1 6 4 10 3s3 5 7 5 5-4 8-2M11 28c3-2 6-1 8 1M24 9c-1 3 1 5 4 5" />
        </svg>
        <span>
          {lines(t['home.side.world']).map((line, i) => (i === 0 ? line : [<br />, line]))}
        </span>
      </p>
    </aside>
  </section>

  <section class="sections" aria-labelledby="home-sections" data-sections>
    <div class="sections-head">
      <h2 id="home-sections">{t['home.sections.title']}</h2>
      <p>{t['home.sections.note']}</p>
    </div>
    <ul class="section-cards">
      {sections.map((s) => (
        <li>
          <a class="section-card glass" href={s.href}>
            <span class="section-art">
              <SectionArt id={s.id} />
            </span>
            <span class="section-text">
              <b>{s.title}</b>
              <small>{s.note}</small>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <p class="model-credits">
    {creditBefore}
    {credits.map((part, i) => (
      <>
        {i > 0 && '; '}
        <span lang={part.lang}>{part.text}</span>
      </>
    ))}
    {creditAfter}
  </p>
</BaseLayout>

<script>
  import { highlightStructures } from '@heart-atlas/viewer/events';
  import type { HeroHeartHandle, HeroHeartOptions } from '@heart-atlas/viewer/hero';
  import { floatOffset } from '../../lib/home-motion.ts';
  import { currentMotion, MOTION_EVENT } from '../../lib/motion.ts';

  // Lines from each card to its structure on the heart. Drawn only while the cards sit around
  // the heart (wide screens); on narrow screens the cards stack and CSS hides the lines.
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const svg = stage?.querySelector<SVGSVGElement>('[data-links]');
  const poster = stage?.querySelector<HTMLImageElement>('[data-poster]');
  const nodes = [...(stage?.querySelectorAll<HTMLElement>('.node') ?? [])];
  /** Where the live heart puts each anchor now, as shares of the poster; empty before it loads. */
  let live: Record<string, [number, number]> = {};

  interface Box {
    left: number;
    top: number;
    width: number;
    height: number;
  }
  /** Card line starts and the poster box, relative to the stage; measured on layout changes. */
  let layout: { image: Box; starts: [number, number][] } | null = null;
  const links = nodes.map((node) => svg?.querySelector(`[data-card="${node.dataset['card']}"]`));
  /** How far each card floats now, CSS pixels down; all zero unless the cards float. */
  let drift = nodes.map(() => 0);

  // In full motion the cards float slowly around the heart and their lines follow. The cards
  // float only where the lines are drawn, and stand still while the stage is off screen.
  const slots = nodes.map((node) => node.parentElement);
  let floating = 0;
  /** When the cards started floating, so they set off from where they stand. */
  let floatStart = 0;
  let stageOnScreen = false;

  function float(time: number) {
    if (!floatStart) floatStart = time;
    // Offsets from the start, so no card jumps when floating starts or resumes.
    drift = nodes.map((_, i) => floatOffset(time - floatStart, i) - floatOffset(0, i));
    slots.forEach((slot, i) => slot?.style.setProperty('translate', `0 ${drift[i] ?? 0}px`));
    paint();
    floating = requestAnimationFrame(float);
  }

  function updateFloat() {
    stage?.classList.toggle('idle', !stageOnScreen);
    const move = stageOnScreen && currentMotion() === 'full' && layout !== null;
    if (move && !floating) floating = requestAnimationFrame(float);
    if (move || !floating) return;
    cancelAnimationFrame(floating);
    floating = 0;
    floatStart = 0;
    drift = nodes.map(() => 0);
    for (const slot of slots) slot?.style.removeProperty('translate');
    paint();
  }

  function measure() {
    layout = null;
    if (!stage || !svg || !poster || getComputedStyle(svg).display === 'none') return;
    const box = stage.getBoundingClientRect();
    const rect = poster.getBoundingClientRect();
    const image = {
      left: rect.left - box.left,
      top: rect.top - box.top,
      width: rect.width,
      height: rect.height,
    };
    const starts = nodes.map((node, i): [number, number] => {
      const card = node.getBoundingClientRect();
      // The line leaves the card from its edge facing the heart, measured without the drift.
      const before = card.left + card.width / 2 < rect.left + rect.width / 2;
      const y = card.top + card.height / 2 - box.top - (drift[i] ?? 0);
      return [(before ? card.right : card.left) - box.left, y];
    });
    svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    layout = { image, starts };
  }

  /** Writes the lines from the measured layout: no layout reads, so it can run every frame. */
  function paint() {
    if (!svg || !layout) return;
    const { image, starts } = layout;
    nodes.forEach((node, i) => {
      const link = links[i];
      const [cx, start] = starts[i] ?? [0, 0];
      const cy = start + (drift[i] ?? 0);
      if (!link) return;
      const [x, y] = live[node.dataset['anchorId'] ?? ''] ?? [
        Number(node.dataset['anchorX']),
        Number(node.dataset['anchorY']),
      ];
      const ax = image.left + x * image.width;
      const ay = image.top + y * image.height;
      const [line, ring, halo, dot, end] = link.children;
      line?.setAttribute('x1', String(cx));
      line?.setAttribute('y1', String(cy));
      line?.setAttribute('x2', String(ax));
      line?.setAttribute('y2', String(ay));
      for (const point of [ring, halo, dot]) {
        point?.setAttribute('cx', String(ax));
        point?.setAttribute('cy', String(ay));
      }
      end?.setAttribute('cx', String(cx));
      end?.setAttribute('cy', String(cy));
    });
    svg.classList.add('drawn');
  }

  function draw() {
    measure();
    paint();
    updateFloat();
  }

  if (stage) {
    // Cards change size when the web fonts arrive, so lines are drawn again then too.
    const observer = new ResizeObserver(draw);
    observer.observe(stage);
    for (const node of nodes) observer.observe(node);
    void document.fonts.ready.then(draw);
  }

  if (stage) {
    new IntersectionObserver(([entry]) => {
      stageOnScreen = entry?.isIntersecting ?? false;
      updateFloat();
    }).observe(stage);
    window.addEventListener(MOTION_EVENT, updateFloat);
  }

  // The section pictures stand still while their row is off screen.
  const row = document.querySelector<HTMLElement>('[data-sections]');
  if (row) {
    new IntersectionObserver(([entry]) => {
      row.classList.toggle('idle', !(entry?.isIntersecting ?? false));
    }).observe(row);
  }

  // Cards light their structures on the live heart.
  for (const node of nodes) {
    const ids = (node.dataset['structures'] ?? '').split(' ').filter(Boolean);
    const on = () => highlightStructures(ids, { ghost: 'ghost' in node.dataset });
    const off = () => highlightStructures([]);
    node.addEventListener('pointerenter', on);
    node.addEventListener('focus', on);
    node.addEventListener('pointerleave', off);
    node.addEventListener('blur', off);
  }

  // The live heart: with motion "full" it loads by itself once the stage is on screen and the
  // page is idle; otherwise the poster stays and a button loads it.
  const heart = stage?.querySelector<HTMLElement>('[data-heart]');
  const mount = stage?.querySelector<HTMLElement>('[data-hero-mount]');
  const button = stage?.querySelector<HTMLButtonElement>('[data-load3d]');
  const data = stage?.querySelector('[data-hero-data]')?.textContent;
  let handle: HeroHeartHandle | null = null;
  let state: 'poster' | 'loading' | 'live' | 'failed' = 'poster';
  let onScreen = false;
  /** Checked once the page is idle: creating a WebGL context costs time on the first screen. */
  let webgl: boolean | null = null;

  function hasWebGL(): boolean {
    try {
      const canvas = document.createElement('canvas');
      const gl = canvas.getContext('webgl2') ?? canvas.getContext('webgl');
      // Browsers cap live contexts, so the probe gives its context back at once.
      gl?.getExtension('WEBGL_lose_context')?.loseContext();
      return gl !== null;
    } catch {
      return false;
    }
  }

  const whenIdle = (task: () => void) => {
    if ('requestIdleCallback' in window) requestIdleCallback(task, { timeout: 3000 });
    else setTimeout(task, 1000);
  };

  // The button stays while the model loads, so keyboard focus has somewhere to be.
  function showButton() {
    if (!button) return;
    button.hidden = !webgl || state === 'live' || state === 'failed' || currentMotion() === 'full';
    button.setAttribute('aria-disabled', String(state === 'loading'));
  }

  async function load() {
    if (state !== 'poster' || !webgl || !heart || !mount || !data) return;
    state = 'loading';
    showButton();
    const fail = () => {
      state = 'failed';
      handle?.destroy();
      handle = null;
      heart.classList.remove('live');
      poster?.removeAttribute('aria-hidden');
      live = {};
      paint();
      showButton();
    };
    try {
      const { mountHeroHeart } = await import('@heart-atlas/viewer/hero');
      const options = JSON.parse(data) as Pick<
        HeroHeartOptions,
        'models' | 'structures' | 'anchors' | 'posterAspect' | 'label'
      >;
      handle = mountHeroHeart(mount, {
        ...options,
        motion: currentMotion(),
        onReady: () => {
          if (state !== 'loading') return;
          state = 'live';
          const hadFocus = document.activeElement === button;
          heart.classList.add('live');
          // The live heart has its own name; the hidden poster leaves the accessibility tree.
          poster?.setAttribute('aria-hidden', 'true');
          showButton();
          if (hadFocus) mount.querySelector<HTMLElement>('[role="img"]')?.focus();
        },
        onAnchors: (points) => {
          live = points;
          paint();
        },
        onError: fail,
      });
    } catch {
      // The 3D code did not load (offline, stale deploy): the poster stays.
      fail();
    }
  }

  function loadWhenIdle() {
    if (currentMotion() === 'full' && onScreen) whenIdle(() => void load());
  }

  if (heart && mount && data) {
    whenIdle(() => {
      webgl = hasWebGL();
      showButton();
      if (!webgl) return;
      new IntersectionObserver(([entry]) => {
        onScreen = entry?.isIntersecting ?? false;
        loadWhenIdle();
      }).observe(heart);
      button?.addEventListener('click', () => void load());
      window.addEventListener(MOTION_EVENT, () => {
        handle?.setMotion(currentMotion());
        showButton();
        loadWhenIdle();
      });
    });
  }
</script>

<style>
  :global(:root) {
    --body-fill: rgb(143 186 245 / 30%);
    --body-line: rgb(110 160 235 / 55%);
    --grid-line: rgb(31 95 209 / 10%);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root) {
      --body-fill: rgb(70 120 230 / 22%);
      --body-line: rgb(120 165 255 / 45%);
      --grid-line: rgb(122 167 255 / 10%);
    }
  }

  :global(body.wide) {
    background:
      radial-gradient(90% 70% at 55% 30%, var(--color-bg-2), var(--color-bg) 70%) fixed,
      var(--color-bg);
  }

  .glass {
    border: 1px solid var(--glass-line);
    background: var(--glass);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px) saturate(1.2);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  svg path {
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Hero: copy | stage | side column. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 26rem) minmax(0, 1fr) minmax(0, 12rem);
    gap: 0.75rem;
    align-items: start;
  }

  .copy {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block-start: 1.25rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 5vw, 4.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  h1 em {
    background: linear-gradient(
      100deg,
      var(--color-blue),
      color-mix(in srgb, var(--color-blue) 60%, #20b8ff)
    );
    background-clip: text;
    color: transparent;
    font-style: normal;
  }

  .tagline {
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 82%, var(--color-bg));
    font-size: clamp(1.375rem, 2.2vw, 1.875rem);
    line-height: 1.22;
  }

  .lead {
    max-inline-size: 42ch;
    margin: 0;
    color: var(--color-muted);
    font-size: 1.0625rem;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cta {
    display: inline-flex;
    gap: 0.75rem;
    align-items: center;
    min-block-size: 3.375rem;
    padding-inline: 1.5rem;
    border-radius: 0.875rem;
    font-weight: 600;
  }

  .cta.primary {
    background: var(--color-accent);
    box-shadow: 0 12px 26px -10px color-mix(in srgb, var(--color-accent) 70%, transparent);
    color: var(--color-on-accent);
  }

  .arrow {
    transition: translate 0.2s;
  }

  :global([dir='rtl']) .arrow {
    scale: -1 1;
  }

  .cta.primary:hover .arrow {
    translate: 4px 0;
  }

  :global([dir='rtl']) .cta.primary:hover .arrow {
    translate: -4px 0;
  }

  .cta.ghost {
    padding-inline: 0.625rem 1.25rem;
  }

  .cta-icon {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-blue) 14%, transparent);
    color: var(--color-blue);
  }

