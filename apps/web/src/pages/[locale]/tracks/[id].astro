---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getMessages } from '../../../i18n/messages.ts';
import { localePath } from '../../../i18n/paths.ts';
import { foreign, trackRoutes } from '../../../lib/track-routes.ts';

export const getStaticPaths = (() => trackRoutes()) satisfies GetStaticPaths;

const { locale, id } = Astro.params;
const { track, contentLocale, steps, pageLocales, translatedLocales } = Astro.props;
const t = getMessages(locale);
const base = import.meta.env.BASE_URL;
const fallback = contentLocale !== locale;
// A fallback page points search engines at the original track.
const canonical = new URL(localePath(base, contentLocale, `tracks/${id}/`), Astro.site);
const langOf = (code: string) => foreign(code, locale);
---

<BaseLayout
  locale={locale}
  title={track.title}
  description={track.description}
  pageLocales={pageLocales}
  translatedLocales={fallback ? [] : translatedLocales}
>
  {fallback && <link slot="head" rel="canonical" href={canonical} />}
  <p class="track-up">
    <a href={localePath(base, locale, 'tracks/')}>{t['tracks.title']}</a>
  </p>
  {fallback && (
    <p class="translation-notice" role="note">
      {t['tracks.translationMissing']}
    </p>
  )}
  <h1 {...langOf(contentLocale)}>{track.title}</h1>
  <p {...langOf(contentLocale)}>{track.description}</p>
  <p class="track-meta">{t[`tracks.level.${track.level}`]}</p>
  {/* Filled by the script from the reader's progress; without JavaScript the list is enough. */}
  <p
    class="track-continue"
    hidden
    data-track-continue
    data-start={t['tracks.start']}
    data-continue={t['tracks.continue']}
    data-finished={t['tracks.finished']}
  ></p>
  <ol class="track-steps" data-track-steps>
    {steps.map((step, index) => (
      <li class="track-step" data-key={step.key}>
        <div {...langOf(step.page.contentLocale)}>
          <a
            id={`track-step-${index}`}
            href={`${localePath(base, locale, `${step.path}/`)}?track=${id}`}
          >
            {step.page.entry.data.title}
          </a>
          <p>{step.page.entry.data.description}</p>
        </div>
        <div class="track-progress">
          <label class="track-read" hidden>
            {/* Every box says "Read"; its name adds the step title to tell them apart. */}
            <input type="checkbox" aria-labelledby={`track-read-${index} track-step-${index}`} />
            <span id={`track-read-${index}`}>{t['tracks.read']}</span>
          </label>
          {step.quiz && (
            <span class="track-quiz" hidden>
              {t['tracks.quizDone']}
            </span>
          )}
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>

<script>
  import { initTrackPage } from '../../../lib/track-page.ts';

  const list = document.querySelector<HTMLElement>('[data-track-steps]');
  const next = document.querySelector<HTMLElement>('[data-track-continue]');
  if (list && next) initTrackPage(list, next);
</script>

<style>
  .track-up {
    margin-block-end: 0;
    font-size: 0.875rem;
  }

  .translation-notice {
    padding-block: 0.75rem;
    padding-inline: 1rem;
    border-inline-start: 4px solid var(--color-border);
    background: var(--color-notice-bg);
  }

  .track-meta {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .track-steps {
    display: grid;
    gap: 0.75rem;
    padding-inline-start: 1.5rem;
  }

  .track-step a {
    font-weight: 600;
  }

  .track-step p {
    margin-block: 0.25rem 0;
  }

  .track-progress {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    margin-block-start: 0.25rem;
    font-size: 0.875rem;
  }

  .track-read {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
  }

  .track-read[hidden],
  .track-quiz[hidden] {
    display: none;
  }

  .track-quiz {
    padding-block: 0.125rem;
    padding-inline: 0.5rem;
    border-radius: 999px;
    background: var(--color-notice-bg);
  }

  .track-continue a {
    font-weight: 600;
  }
</style>
