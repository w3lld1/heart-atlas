---
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';
import EcgEmbed from '../../../components/heart-clock/EcgEmbed.tsx';
import {
  heartClockMessageKeys,
  type HeartClockMessages,
} from '../../../components/heart-clock/HeartClockDemo.tsx';
import EmbedLayout from '../../../layouts/EmbedLayout.astro';
import { localeCodes } from '../../../i18n/locales.ts';
import { getMessages } from '../../../i18n/messages.ts';
import { localePath } from '../../../i18n/paths.ts';

export const getStaticPaths = (() =>
  localeCodes.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as InferGetStaticParamsType<typeof getStaticPaths>;
const t = getMessages(locale);
const messages = Object.fromEntries(
  heartClockMessageKeys.map((key) => [key, t[key]]),
) as HeartClockMessages;
const canonical = new URL(localePath(import.meta.env.BASE_URL, locale, 'heart-clock/'), Astro.site);
---

<EmbedLayout locale={locale} title={t['heartClock.title']} canonical={canonical}>
  <h1>{t['heartClock.title']}</h1>
  <p class="schematic" role="note">
    {t['heartClock.schematic']}
  </p>
  {/* The query string is read in the browser, so the island is not rendered at build time. */}
  <EcgEmbed client:only="react" locale={locale} messages={messages} />
  <noscript>
    <p>{t['embed.noScript']}</p>
  </noscript>
</EmbedLayout>

<style>
  h1 {
    margin-block-start: 0;
    font-size: 1.25rem;
  }

  .schematic {
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-inline-start: 4px solid var(--color-accent);
    font-size: 0.875rem;
  }
</style>
