---
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localeCodes } from '../../../i18n/locales.ts';
import { getMessages } from '../../../i18n/messages.ts';

export const getStaticPaths = (() =>
  localeCodes.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as InferGetStaticParamsType<typeof getStaticPaths>;
const t = getMessages(locale);
const base = import.meta.env.BASE_URL;

// Pagefind UI strings come from our messages, so every registry locale gets its own wording.
const prefix = 'search.ui.';
const translations = Object.fromEntries(
  Object.entries(t)
    .filter(([key]) => key.startsWith(prefix))
    .map(([key, value]) => [key.slice(prefix.length), value]),
);
---

<BaseLayout locale={locale} title={t['search.title']} hideSearch>
  <h1 id="search-title">{t['search.title']}</h1>
  <div id="search" data-base={base} data-translations={JSON.stringify(translations)}></div>
  <p id="search-status" class="visually-hidden" role="status" aria-live="polite"></p>
  <p id="search-unavailable" hidden>
    {t['search.noIndex']}
  </p>
  <noscript>
    <p>{t['search.noScript']}</p>
  </noscript>
</BaseLayout>

<script>
  // Pagefind UI ships with the index (dist/pagefind/), so it exists only in a built site.
  type PagefindUIInstance = { triggerSearch(term: string): void };
  type PagefindUIConstructor = new (options: Record<string, unknown>) => PagefindUIInstance;

  const container = document.querySelector<HTMLElement>('#search');
  const base = container?.dataset['base'] ?? '/';
  const translations: unknown = JSON.parse(container?.dataset['translations'] ?? '{}');
  const query = new URLSearchParams(location.search).get('q')?.trim() ?? '';

  const showUnavailable = () =>
    document.querySelector('#search-unavailable')?.removeAttribute('hidden');

  const style = document.createElement('link');
  style.rel = 'stylesheet';
  style.href = `${base}pagefind/pagefind-ui.css`;

  const script = document.createElement('script');
  script.src = `${base}pagefind/pagefind-ui.js`;
  script.onerror = showUnavailable;
  script.onload = () => {
    const { PagefindUI } = window as unknown as { PagefindUI: PagefindUIConstructor };
    const ui = new PagefindUI({
      element: '#search',
      baseUrl: base,
      showImages: false,
      showSubResults: true,
      autofocus: !query,
      translations,
    });
    // Pagefind labels its input with `title` only; tie it to the page heading instead.
    document
      .querySelector('.pagefind-ui__search-input')
      ?.setAttribute('aria-labelledby', 'search-title');
    // Pagefind's result message is not announced; mirror it into a live region.
    const status = document.querySelector('#search-status');
    if (container && status) {
      // Each result grows when its data arrives and pushes the ones below it (CLS). The first
      // page of results for a search stays invisible until every shown result has loaded, then
      // appears at its final size. "Load more" is not hidden, and a result whose data never
      // arrives does not keep the list hidden for more than settleMs.
      const settleMs = 1500;
      let message = '';
      let settledMessage: string | undefined;
      let timer: ReturnType<typeof setTimeout> | undefined;
      const settle = () => {
        container.removeAttribute('data-settling');
        settledMessage = message;
        clearTimeout(timer);
        timer = undefined;
      };
      new MutationObserver(() => {
        message = container.querySelector('.pagefind-ui__message')?.textContent ?? '';
        if (status.textContent !== message) status.textContent = message;
        const loading =
          container.querySelector('.pagefind-ui__results .pagefind-ui__loading') !== null;
        if (!loading) {
          settle();
        } else if (message !== settledMessage) {
          container.setAttribute('data-settling', '');
          timer ??= setTimeout(settle, settleMs);
        }
      }).observe(container, { childList: true, subtree: true, characterData: true });
    }
    if (query) ui.triggerSearch(query);
  };

  style.onload = () => document.head.append(script);
  style.onerror = showUnavailable;
  document.head.append(style);
</script>

<style is:global>
  #search {
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-bg);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-notice-bg);
    --pagefind-ui-font: var(--font-body);
    --pagefind-ui-border-radius: 12px;

    /* Results arrive after load; reserving a screen keeps the footer from jumping (CLS). */
    min-block-size: 100vb;
  }

  /* stylelint-disable-next-line selector-class-pattern -- class name set by Pagefind UI */
  #search[data-settling] .pagefind-ui__results {
    visibility: hidden;
  }

  /* Pagefind's own look, brought to the site tokens: display font for titles, a soft accent
     highlight instead of the browser's yellow, a readable "clear" button. */
  /* stylelint-disable selector-class-pattern -- class names set by Pagefind UI */
  #search .pagefind-ui__result-title {
    font-family: var(--font-display);
  }

  #search mark {
    border-radius: 3px;
    background: var(--color-notice-bg);
    background: color-mix(in srgb, var(--color-accent) 24%, transparent);
    color: inherit;
  }

  #search .pagefind-ui__search-clear {
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Pagefind indents sub-results and places their arrow with physical properties; these follow
     the page direction. */
  #search .pagefind-ui__result-nested {
    padding-inline: calc(20px * var(--pagefind-ui-scale)) 0;
  }

  #search .pagefind-ui__result-nested .pagefind-ui__result-link::before {
    inset-inline: auto calc(100% + 0.1em);
    color: var(--color-muted);
  }
  /* stylelint-enable selector-class-pattern */

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
