---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales } from '../../../i18n/locales.ts';
import { getMessages } from '../../../i18n/messages.ts';
import { localePath } from '../../../i18n/paths.ts';
import { articlePages, typesListedElsewhere, type ArticlePage } from '../../../lib/articles.ts';
import { articleTypes, type ArticleType } from '../../../lib/content.ts';
import { groupDiseases, type DiseaseGroup } from '../../../lib/disease-groups.ts';

type Entry = Awaited<ReturnType<typeof getCollection<'articles'>>>[number];

export const getStaticPaths = (async () => {
  const byPage = new Map<string, ArticlePage<Entry>[]>();
  for (const page of articlePages(await getCollection('articles'), locales)) {
    if (typesListedElsewhere.has(page.type)) continue;
    const key = `${page.locale}/${page.type}`;
    byPage.set(key, [...(byPage.get(key) ?? []), page]);
  }
  return [...byPage].map(([key, pages]) => {
    const [locale = '', type = ''] = key.split('/');
    const pageLocales = [...byPage.keys()]
      .filter((other) => other.endsWith(`/${type}`))
      .map((other) => other.slice(0, -type.length - 1));
    return { params: { locale, type }, props: { pages, pageLocales } };
  });
}) satisfies GetStaticPaths;

const { locale, type } = Astro.params;
const { pages, pageLocales } = Astro.props;
const t = getMessages(locale);
const base = import.meta.env.BASE_URL;
const title = (articleTypes as readonly string[]).includes(type)
  ? t[`articles.type.${type as ArticleType}`]
  : type;
const sorted = [...pages].sort((a, b) =>
  a.entry.data.title.localeCompare(b.entry.data.title, locale),
);
// Diseases come in groups with a filter; other sections are short and stay one plain grid.
// Spec: docs/plans/2026-10-13-disease-catalog.md.
const grouped = type === 'disease';
const groups: { group: DiseaseGroup | undefined; items: typeof sorted }[] = grouped
  ? groupDiseases(sorted, (page) => page.slug)
  : [{ group: undefined, items: sorted }];
const groupTitle = (group: DiseaseGroup) => t[`catalog.group.${group}`];
---

<BaseLayout locale={locale} title={title} pageLocales={pageLocales}>
  <h1>{title}</h1>
  {grouped && (
    <>
      <form
        class="catalog-filter"
        role="search"
        aria-labelledby="catalog-filter-label"
        hidden
        data-catalog-filter
      >
        <label id="catalog-filter-label" for="catalog-filter-input">
          {t['catalog.filter.label']}
        </label>
        <input id="catalog-filter-input" type="search" autocomplete="off" />
      </form>
      <nav class="catalog-groups" aria-label={t['catalog.groups']}>
        <ul>
          {groups.map(({ group, items }) => (
            <li data-catalog-jump={group}>
              <a href={`#group-${group}`}>
                {group && groupTitle(group)} <span class="catalog-count">{items.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <p
        class="catalog-status"
        role="status"
        data-catalog-status
        data-message={t['catalog.filter.found']}
      />
      <p class="catalog-empty" hidden data-catalog-empty>
        {t['catalog.filter.empty']}{' '}
        <a href={localePath(base, locale, 'search/')} data-catalog-search>
          {t['catalog.filter.searchAll']}
        </a>
      </p>
    </>
  )}
  {groups.map(({ group, items }) => (
    <section
      class="catalog-group"
      aria-labelledby={group ? `group-${group}` : undefined}
      data-catalog-group={group ?? ''}
    >
      {group && <h2 id={`group-${group}`}>{groupTitle(group)}</h2>}
      <ul class="catalog-cards" role="list">
        {items.map((page) => (
          <li class="catalog-card" data-catalog-card>
            {/* Language and direction on the content, as the page may fall back to another locale. */}
            <div
              lang={page.contentLocale === locale ? undefined : page.contentLocale}
              dir={page.contentLocale === locale ? undefined : locales[page.contentLocale]?.dir}
            >
              <a class="catalog-link" href={localePath(base, locale, `${type}/${page.slug}/`)}>
                {page.entry.data.title}
              </a>
              <p>{page.entry.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<script>
  // Narrows the cards as the reader types. Without JavaScript the form stays hidden and every
  // card is shown.
  const form = document.querySelector<HTMLFormElement>('[data-catalog-filter]');
  const input = form?.querySelector('input');
  const status = document.querySelector<HTMLElement>('[data-catalog-status]');
  const empty = document.querySelector<HTMLElement>('[data-catalog-empty]');
  const searchLink = document.querySelector<HTMLAnchorElement>('[data-catalog-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-catalog-card]')].map((card) => ({
    card,
    text: (card.textContent ?? '').toLocaleLowerCase(),
  }));
  const groups = [...document.querySelectorAll<HTMLElement>('[data-catalog-group]')];
  const jumpOf = (group: HTMLElement) =>
    document.querySelector<HTMLElement>(
      `[data-catalog-jump="${group.dataset['catalogGroup'] ?? ''}"]`,
    );

  if (form && input && status && empty && searchLink) {
    const searchBase = searchLink.href;
    let announce: ReturnType<typeof setTimeout> | undefined;
    const apply = () => {
      const query = input.value.trim().toLocaleLowerCase();
      let shown = 0;
      for (const { card, text } of cards) {
        const match = query === '' || text.includes(query);
        card.hidden = !match;
        if (match) shown += 1;
      }
      for (const group of groups) {
        const visible = group.querySelector('[data-catalog-card]:not([hidden])') !== null;
        group.hidden = !visible;
        const jump = jumpOf(group);
        if (jump) jump.hidden = !visible;
      }
      empty.hidden = shown > 0;
      const url = new URL(searchBase);
      if (query) url.searchParams.set('q', input.value.trim());
      searchLink.href = url.href;
      // The count is announced once typing pauses, not on every key.
      clearTimeout(announce);
      const message = query
        ? (status.dataset['message'] ?? '').replaceAll('{count}', String(shown))
        : '';
      announce = setTimeout(() => (status.textContent = message), 400);
    };
    form.addEventListener('submit', (event) => event.preventDefault());
    input.addEventListener('input', apply);
    form.hidden = false;
    apply();
  }
</script>

<style>
  .catalog-filter {
    display: grid;
    gap: 0.375rem;
    max-inline-size: 28rem;
  }

  .catalog-filter[hidden] {
    display: none;
  }

  .catalog-filter label {
    font-weight: 600;
  }

  .catalog-filter input {
    padding-block: 0.625rem;
    padding-inline: 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }

  .catalog-filter input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .catalog-groups ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1.25rem 0;
    padding: 0;
    list-style: none;
  }

  .catalog-groups li[hidden] {
    display: none;
  }

  .catalog-groups a {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    min-block-size: 2rem;
    padding-block: 0.25rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .catalog-groups a:hover {
    border-color: var(--color-accent);
  }

  .catalog-count {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .catalog-status {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  /* Stays rendered when empty: a live region that appears with its text is often not read. */
  .catalog-status:empty {
    margin: 0;
  }

  .catalog-group[hidden] {
    display: none;
  }

  .catalog-group h2 {
    margin-block: 2rem 0.75rem;
    scroll-margin-block-start: 1rem;
  }

  .catalog-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .catalog-card {
    display: flex;
  }

  .catalog-card[hidden] {
    display: none;
  }

  .catalog-card > div {
    position: relative;
    flex: 1;
    padding-block: 0.875rem;
    padding-inline: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg-2);
    transition: border-color 0.2s;
  }

  .catalog-card > div:hover,
  .catalog-card > div:focus-within {
    border-color: var(--color-accent);
  }

  /* The whole card is the link's target; the title stays the only link in the tab order. */
  .catalog-link {
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .catalog-link::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    content: '';
  }

  @supports selector(:has(*)) {
    .catalog-link:focus-visible {
      outline: none;
    }
  }

  .catalog-card > div:has(.catalog-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .catalog-card p {
    display: -webkit-box;
    margin-block: 0.375rem 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.875rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }
</style>
