---
// Test-only page (HA_TEST_CONTENT=1 builds): the heart clock with the rhythm parameters of
// docs/plans/2026-10-13-heart-clock-rhythms.md, before any real preset uses them, and a clock
// without the Wiggers diagram (frontmatter `wiggers: false`), and limb leads I, II and III next to
// a V1 preset (docs/plans/2026-10-13-heart-clock-three-leads.md). Other builds make no page here.
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';
import HeartClockDemo, {
  heartClockMessageKeys,
  type HeartClockMessages,
} from '../../../components/heart-clock/HeartClockDemo.tsx';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localeCodes } from '../../../i18n/locales.ts';
import { getMessages } from '../../../i18n/messages.ts';

export const getStaticPaths = (() =>
  process.env['HA_TEST_CONTENT'] === '1'
    ? localeCodes.map((locale) => ({ params: { locale } }))
    : []) satisfies GetStaticPaths;

const { locale } = Astro.params as InferGetStaticParamsType<typeof getStaticPaths>;
const t = getMessages(locale);
const messages = Object.fromEntries(
  heartClockMessageKeys.map((key) => [key, t[key]]),
) as HeartClockMessages;
---

<BaseLayout locale={locale} title="Heart clock rhythms" description="Test page.">
  <h1>Heart clock rhythms</h1>
  <section data-test="pauses">
    <HeartClockDemo
      client:load
      locale={locale}
      messages={messages}
      params={{ heartRate: 60, pauseEvery: 2, pauseDuration: 2000 }}
    />
  </section>
  <section data-test="v1">
    <HeartClockDemo
      client:load
      locale={locale}
      messages={messages}
      lead="V1"
      params={{
        prInterval: 100,
        qrsDuration: 140,
        deltaWave: 40,
        stShift: 0.2,
        stSlope: 1,
        tAmplitude: -0.2,
      }}
    />
  </section>
  <section data-test="flutter">
    <HeartClockDemo
      client:load
      locale={locale}
      messages={messages}
      params={{ heartRate: 75, pAmplitude: 0, flutterConduction: 4, flutterAmplitude: 0.2 }}
    />
  </section>
  <section data-test="limb-leads">
    <HeartClockDemo
      client:load
      locale={locale}
      messages={messages}
      presets={['normal', 'brugada-syndrome']}
      wiggers={false}
    />
  </section>
  <section data-test="no-wiggers">
    <HeartClockDemo
      client:load
      locale={locale}
      messages={messages}
      presets={['normal', 'av-block-third-degree']}
      preset="av-block-third-degree"
      wiggers={false}
    />
  </section>
</BaseLayout>
