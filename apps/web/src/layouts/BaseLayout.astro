---
import '@fontsource-variable/manrope';
import '@fontsource-variable/onest';
import { getCollection } from 'astro:content';
import MotionScript from '../components/MotionScript.astro';
import ServiceWorker from '../components/ServiceWorker.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { defaultLocale, localeCodes, locales } from '../i18n/locales.ts';
import { getMessages } from '../i18n/messages.ts';
import { localePath, switchLocalePath } from '../i18n/paths.ts';
import { articlePages } from '../lib/articles.ts';
import { siteNav } from '../lib/site-nav.ts';
import '../styles/base.css';

interface Props {
  locale: string;
  title?: string;
  description?: string;
  /** Locales that have this page; the language switcher links the others to their home page. */
  pageLocales?: readonly string[];
  /** Locales with their own translation of this page, listed as hreflang alternates. */
  translatedLocales?: readonly string[];
  /** Adds the page to the search index. Only pages with real content should set it. */
  searchable?: boolean;
  /** Hides the header search form, for the search page itself. */
  hideSearch?: boolean;
  /** Full-width layout for the home page instead of the reading column. */
  wide?: boolean;
}

const {
  locale,
  title,
  description,
  pageLocales = localeCodes,
  translatedLocales = pageLocales,
  searchable = false,
  hideSearch = false,
  wide = false,
} = Astro.props;
const t = getMessages(locale);
const base = import.meta.env.BASE_URL;
const dir = locales[locale]?.dir ?? 'ltr';
const pageTitle = title ? `${title} · ${t['site.name']}` : t['site.name'];
// The menu lists the sections this language can open, including articles from a fallback language.
const nav = siteNav(
  articlePages(await getCollection('articles'), locales)
    .filter((page) => page.locale === locale)
    .map((page) => page.type),
  articlePages(await getCollection('tracks'), locales).some((page) => page.locale === locale),
);
// The page path after "<base><locale>/", for the current menu item.
const localeRoot = localePath(base, locale);
const pagePath = Astro.url.pathname.startsWith(localeRoot)
  ? Astro.url.pathname.slice(localeRoot.length)
  : '';
---

<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description ?? t['site.description']} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.${locale}.webmanifest`} />
    <meta name="theme-color" content="#f3f7fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070d1c" media="(prefers-color-scheme: dark)" />
    {translatedLocales.map((code) => (
      <link
        rel="alternate"
        hreflang={code}
        href={new URL(switchLocalePath(Astro.url.pathname, base, code, localeCodes), Astro.site)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(base, defaultLocale), Astro.site)}
    />
    <title>{pageTitle}</title>
    <MotionScript />
    <slot name="head" />
  </head>
  <body class:list={{ wide }}>
    <a class="skip-link" href="#content">
      {t['a11y.skipToContent']}
    </a>
    <SiteHeader
      locale={locale}
      nav={nav}
      pagePath={pagePath}
      pageLocales={pageLocales}
      hideSearch={hideSearch}
    />
    <main id="content" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <SiteFooter locale={locale} nav={nav} />
    {import.meta.env.PROD && <ServiceWorker locale={locale} />}
  </body>
</html>

<style is:global>
  body {
    /* Header and footer bars; the reading column stays narrower. */
    --site-width: 76rem;
  }

  body.wide {
    --site-width: 90rem;
  }

  main {
    max-inline-size: 48rem;
    margin-inline: auto;
    padding-block: 2rem;
    padding-inline: 1rem;
  }

  /* Decorations of the wide layout may reach past the edges; they never scroll the page. */
  body.wide main {
    max-inline-size: var(--site-width);
    overflow-x: clip;
  }

  @media (width >= 48rem) {
    body.wide main {
      padding-inline: 1.5rem;
    }
  }

  .skip-link {
    position: absolute;
    z-index: 1;
    inset-inline-start: 1rem;
    inset-block-start: -3rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--color-accent);
    background: var(--color-bg);
  }

  .skip-link:focus {
    inset-block-start: 1rem;
  }
</style>
