---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import SearchForm from '../components/SearchForm.astro';
import ServiceWorker from '../components/ServiceWorker.astro';
import { defaultLocale, localeCodes, locales } from '../i18n/locales.ts';
import { getMessages } from '../i18n/messages.ts';
import { localePath, switchLocalePath } from '../i18n/paths.ts';
import { repoUrl } from '../site.ts';
import '../styles/base.css';

interface Props {
  locale: string;
  title?: string;
  description?: string;
  /** Locales that have this page; the language switcher links the others to their home page. */
  pageLocales?: readonly string[];
  /** Locales with their own translation of this page, listed as hreflang alternates. */
  translatedLocales?: readonly string[];
  /** Adds the page to the search index. Only pages with real content should set it. */
  searchable?: boolean;
  /** Hides the header search form, for the search page itself. */
  hideSearch?: boolean;
}

const {
  locale,
  title,
  description,
  pageLocales = localeCodes,
  translatedLocales = pageLocales,
  searchable = false,
  hideSearch = false,
} = Astro.props;
const t = getMessages(locale);
const base = import.meta.env.BASE_URL;
const dir = locales[locale]?.dir ?? 'ltr';
const pageTitle = title ? `${title} · ${t['site.name']}` : t['site.name'];
---

<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description ?? t['site.description']} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.${locale}.webmanifest`} />
    <meta name="theme-color" content="#b3123a" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />
    {translatedLocales.map((code) => (
      <link
        rel="alternate"
        hreflang={code}
        href={new URL(switchLocalePath(Astro.url.pathname, base, code, localeCodes), Astro.site)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(base, defaultLocale), Astro.site)}
    />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">
      {t['a11y.skipToContent']}
    </a>
    <header>
      <a class="site-name" href={localePath(base, locale)}>
        {t['site.name']}
      </a>
      {!hideSearch && <SearchForm locale={locale} />}
      <LanguageSwitcher locale={locale} pageLocales={pageLocales} />
    </header>
    <main id="content" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <footer>
      <p class="disclaimer">{t['footer.disclaimer']}</p>
      <p>
        <a href={`${repoUrl}/blob/main/DISCLAIMER.md`}>{t['footer.disclaimerLink']}</a>
        {' · '}
        {t['footer.license']}
        {' · '}
        <a href={repoUrl}>{t['footer.source']}</a>
        {' · '}
        <a href={localePath(base, locale, 'embed/')}>{t['footer.embed']}</a>
      </p>
    </footer>
    {import.meta.env.PROD && <ServiceWorker locale={locale} />}
  </body>
</html>

<style is:global>
  header,
  main,
  footer {
    max-inline-size: 48rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
    border-block-end: 1px solid var(--color-border);
  }

  .site-name {
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-text);
    text-decoration: none;
  }

  main {
    padding-block: 2rem;
  }

  footer {
    padding-block: 1.5rem;
    border-block-start: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .skip-link {
    position: absolute;
    z-index: 1;
    inset-inline-start: 1rem;
    inset-block-start: -3rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--color-accent);
    background: var(--color-bg);
  }

  .skip-link:focus {
    inset-block-start: 1rem;
  }
</style>
