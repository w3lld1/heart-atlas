---
import { presetLead, presetTreated, type PresetId } from '@heart-atlas/heart-clock';
import type { DiseaseId } from '@heart-atlas/viewer';
import { getMessages } from '../../i18n/messages.ts';
import type { CongenitalModelId } from '../../lib/heart-model.ts';
import CongenitalModel from '../viewer/CongenitalModel.astro';
import HeartModel from '../viewer/HeartModel.astro';
import HeartClockDemo, {
  heartClockMessageKeys,
  type HeartClockMessages,
} from './HeartClockDemo.tsx';

// The article's heart in models: the heart clock with its preset, and the 3D model with the
// disease signs, beating with that clock when there is one (docs/plans/2026-10-12-disease-signs-3d.md).
interface Props {
  locale: string;
  /** The article's preset; the reader can switch between it, normal and its `presetTreated`. */
  preset?: Exclude<PresetId, 'normal'>;
  /** More presets for the switch after `preset`, each with its state after treatment (frontmatter `morePresets`). */
  morePresets?: readonly Exclude<PresetId, 'normal'>[];
  /** false hides the Wiggers diagram (frontmatter `wiggers`). */
  wiggers?: boolean;
  /** The disease whose signs the 3D model shows. */
  disease?: DiseaseId;
  /** A patient model of the article's congenital defect: docs/plans/2026-10-12-congenital-models.md. */
  congenital?: CongenitalModelId;
}

const { locale, preset, morePresets = [], wiggers = true, disease, congenital } = Astro.props;
// Normal, the disease and, when its treatment changes the ECG, the state after treatment
// (docs/plans/2026-10-13-heart-clock-after-treatment.md), then the article's other presets, each with its own.
const withTreated = (id: Exclude<PresetId, 'normal'>): PresetId[] => {
  const treated = presetTreated[id];
  return treated ? [id, treated] : [id];
};
// The schema rejects repeats; the Set keeps the switch right for a direct use of the component.
const choices: PresetId[] = preset
  ? [...new Set<PresetId>(['normal', ...[preset, ...morePresets].flatMap(withTreated)])]
  : [];
const t = getMessages(locale);
const messages = Object.fromEntries(
  heartClockMessageKeys.map((key) => [key, t[key]]),
) as HeartClockMessages;
---

<section class="clock" aria-labelledby="heart-clock-in-model" data-pagefind-ignore>
  <h2 id="heart-clock-in-model">{t['heartClock.inModel']}</h2>
  {preset && (
    <>
      <p class="schematic" role="note">
        {t['heartClock.schematic']}
      </p>
      <HeartClockDemo
        client:visible
        locale={locale}
        messages={messages}
        presets={choices}
        preset={preset}
        lead={presetLead(preset)}
        headingLevel={3}
        wiggers={wiggers}
      />
    </>
  )}
  {disease && (
    <>
      <h3>{t['heartClock.model3d']}</h3>
      <HeartModel
        locale={locale}
        disease={disease}
        headingLevel={4}
        {...(preset ? { cycle: 'page' as const } : {})}
      />
    </>
  )}
  {congenital && (
    <>
      <h3>{t['heartClock.model3d']}</h3>
      <CongenitalModel locale={locale} model={congenital} headingLevel={4} />
    </>
  )}
</section>

<style>
  .clock {
    display: grid;
    gap: 1rem;
    margin-block: 2rem;
  }

  h2,
  h3,
  .schematic {
    margin: 0;
  }

  .schematic {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-inline-start: 4px solid var(--color-accent);
  }
</style>
