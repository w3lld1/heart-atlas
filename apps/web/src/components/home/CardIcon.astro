---
// Icons of the cards around the heart. Decorative: each card's text names its topic.
import type { StageCard } from '../../lib/home.ts';

interface Props {
  id: StageCard['id'];
}

const { id } = Astro.props;
---

<svg class="card-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  {id === 'anatomy' && (
    <>
      <path
        d="M24 42C11 33 6 25 6 18c0-6 4.5-10 9.5-10 3.7 0 6.6 2.1 8.5 5 1.9-2.9 4.8-5 8.5-5 5 0 9.5 4 9.5 10 0 7-5 15-18 24Z"
        fill="var(--color-accent)"
        opacity=".9"
      />
      <path
        d="M18 9c0-4 3-6 3-6M27 10c1-4 4-6 4-6"
        stroke="var(--color-vessel-v)"
        stroke-width="3"
        fill="none"
        stroke-linecap="round"
      />
    </>
  )}
  {id === 'chambers' && (
    <>
      <path
        d="M23 41C12 33 6 26 6 18c0-6 4-10 9-10 4 0 7 3 8 6Z"
        fill="var(--color-vessel-v)"
        opacity=".85"
      />
      <path
        d="M25 41c11-8 17-15 17-23 0-6-4-10-9-10-4 0-7 3-8 6Z"
        fill="var(--color-accent)"
        opacity=".9"
      />
      <path d="M8 22h15M25 20h15" stroke="var(--color-bg)" stroke-width="1.4" />
    </>
  )}
  {id === 'ecg' && (
    <path
      d="M3 26h9l3-7 4 18 5-26 4 21 3-6h14"
      fill="none"
      stroke="var(--color-accent)"
      stroke-width="2.4"
      stroke-linejoin="round"
      stroke-linecap="round"
    />
  )}
  {id === 'valves' && (
    <>
      <circle
        cx="24"
        cy="24"
        r="18"
        fill="none"
        stroke="var(--color-muted)"
        stroke-width="3"
        opacity=".6"
      />
      <path d="M24 24 24 7A17 17 0 0 1 39 32Z" fill="var(--color-blue)" opacity=".55" />
      <path d="M24 24 39 32A17 17 0 0 1 9 32Z" fill="var(--color-blue)" opacity=".4" />
      <path d="M24 24 9 32A17 17 0 0 1 24 7Z" fill="var(--color-blue)" opacity=".25" />
    </>
  )}
  {id === 'flow' && (
    <>
      <path
        d="M8 40C14 28 14 16 24 8M14 40c6-10 8-20 20-28M24 40c2-8 6-14 16-18"
        fill="none"
        stroke="var(--color-vessel-a)"
        stroke-width="3.2"
        stroke-linecap="round"
      />
      <path
        d="M6 32c8-6 10-14 14-22M30 40c2-6 4-10 12-12"
        fill="none"
        stroke="var(--color-vessel-v)"
        stroke-width="3.2"
        stroke-linecap="round"
      />
    </>
  )}
  {id === 'disease' && (
    <>
      <rect x="4" y="16" width="40" height="16" rx="8" fill="var(--color-accent)" opacity=".2" />
      <rect
        x="4"
        y="16"
        width="40"
        height="16"
        rx="8"
        fill="none"
        stroke="var(--color-accent)"
        stroke-width="2"
      />
      <path d="M18 32c2-6 10-6 12 0Z" fill="#e0a526" />
      <circle cx="11" cy="24" r="3" fill="var(--color-accent)" />
      <circle cx="37" cy="23" r="3" fill="var(--color-accent)" />
    </>
  )}
</svg>

<style>
  .card-icon {
    inline-size: 2.875rem;
    block-size: 2.875rem;
  }
</style>
