---
import { isHeartSoundId, type HeartSoundId } from './heart-sounds/auscultation.ts';
import HeartSoundsPlayer from './heart-sounds/HeartSounds.tsx';
import { heartSoundsMessageKeys, type HeartSoundsMessages } from './heart-sounds/messages.ts';
import { heartSoundSources } from './heart-sounds/sources.ts';
import { defaultLocale } from '../i18n/locales.ts';
import { getMessages } from '../i18n/messages.ts';

// The heart sounds player inside an article: <HeartSounds sound="aortic-stenosis" />, placed after
// the text of the diagnosis section, with an optional article caption as children. The reader
// compares the sound with the normal heart (docs/plans/2026-10-13-heart-sounds.md). MDX components
// are not hydrated themselves, so this Astro wrapper renders the island.
interface Props {
  sound: HeartSoundId;
}

const { sound } = Astro.props;
if (!isHeartSoundId(sound)) throw new Error(`<HeartSounds>: unknown sound "${String(sound)}"`);
const { article, sourceUrls } = Astro.locals;
if (article === undefined || sourceUrls === undefined) {
  throw new Error('<HeartSounds> works only on article pages');
}
const locale = Astro.locals.locale ?? defaultLocale;
const t = getMessages(locale);
const messages = Object.fromEntries(
  heartSoundsMessageKeys.map((key) => [key, t[key]]),
) as HeartSoundsMessages;
const sounds: HeartSoundId[] = sound === 'normal' ? ['normal'] : ['normal', sound];
// The player cites the article's own numbered sources, so every source of its sounds must be one.
const citations = Object.fromEntries(
  sounds.map((id) => [
    id,
    heartSoundSources[id]
      .map((source) => {
        const n = sourceUrls.indexOf(source.href) + 1;
        if (n === 0) {
          throw new Error(
            `<HeartSounds sound="${sound}">: add ${source.href} to the sources of ${article.locale}/${article.type}/${article.slug}`,
          );
        }
        return n;
      })
      .sort((a, b) => a - b),
  ]),
);
const titleId = `heart-sounds-${sound}`;
---

<section class="heart-sounds" aria-labelledby={titleId} data-pagefind-ignore>
  <!-- The player and the note are UI text in the page locale; the caption is article text. -->
  <div lang={locale}>
    <h3 id={titleId}>{t['heartSounds.articleTitle']}</h3>
    <p class="schematic" role="note">
      {t['heartSounds.schematic']}
    </p>
    <HeartSoundsPlayer
      client:visible
      messages={messages}
      sounds={sounds}
      sound={sound}
      citations={citations}
    />
  </div>
  {Astro.slots.has('default') && (
    <p class="caption">
      <slot />
    </p>
  )}
</section>

<style>
  /* A framed block with a heading, like the quiz. */
  .heart-sounds {
    margin-block: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg-2);
  }

  /* h3: the block sits inside the diagnosis section. */
  h3 {
    margin-block: 0 0.75rem;
  }

  .schematic {
    margin-block: 0 1rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 4px solid var(--color-accent);
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .caption {
    margin-block: 0.75rem 0;
  }
</style>
