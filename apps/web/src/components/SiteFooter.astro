---
import { getMessages } from '../i18n/messages.ts';
import { localePath } from '../i18n/paths.ts';
import { navLabel, type NavItem } from '../lib/site-nav.ts';
import { repoUrl } from '../site.ts';

interface Props {
  locale: string;
  nav: readonly NavItem[];
}

const { locale, nav } = Astro.props;
const t = getMessages(locale);
const base = import.meta.env.BASE_URL;
---

<!-- The header menu is the site navigation landmark; these lists repeat it without a second one. -->
<footer class="site-footer" data-pagefind-ignore>
  <div class="inner">
    <div class="about">
      <p class="name">
        <b>{t['site.name']}</b>
        <span>{t['site.tagline']}</span>
      </p>
      <p class="disclaimer">{t['footer.disclaimer']}</p>
    </div>
    <div>
      <h2>{t['nav.sections']}</h2>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={localePath(base, locale, item.path)}>{navLabel(t, item)}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2>{t['footer.project']}</h2>
      <ul>
        <li>
          <a href={`${repoUrl}/blob/main/DISCLAIMER.md`}>{t['footer.disclaimerLink']}</a>
        </li>
        <li>
          <a href={repoUrl}>{t['footer.source']}</a>
        </li>
        <li>
          <a href={localePath(base, locale, 'embed/')}>{t['footer.embed']}</a>
        </li>
      </ul>
    </div>
    <p class="license">{t['footer.license']}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: 2rem;
    border-block-start: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-2) 55%, var(--color-bg));
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    max-inline-size: var(--site-width);
    margin-inline: auto;
    padding-block: 2rem 1.5rem;
    padding-inline: 1rem;
  }

  @media (width >= 48rem) {
    .inner {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
    }

    .license {
      grid-column: 1 / -1;
    }

    /* Lines up with the wider gutter of the home page. */
    :global(body.wide) .inner {
      padding-inline: 1.5rem;
    }
  }

  p {
    margin: 0;
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    margin-block-end: 0.75rem;
  }

  .name b {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.0625rem;
  }

  h2 {
    margin-block: 0 0.5rem;
    color: var(--color-text);
    font-size: 0.875rem;
  }

  ul {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .license {
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--color-border);
  }
</style>
