---
import { getMessages } from '../i18n/messages.ts';
import type { Review } from '../lib/content';
import { repoUrl } from '../site.ts';

interface Props {
  locale: string;
  review: Review | null;
  /** Absolute URL of the article, prefilled into the error report. */
  pageUrl: string | URL;
}

const { locale, review, pageUrl } = Astro.props;

const t = getMessages(locale);

const reportUrl = new URL(`${repoUrl}/issues/new`);
reportUrl.searchParams.set('template', 'content-error.yml');
reportUrl.searchParams.set('page', String(pageUrl));
---

{review === null ? (
  <div class="review-notice" role="note" data-pagefind-ignore>
    <p>{t['review.notice']}</p>
    <a href={reportUrl.href}>{t['review.report']}</a>
  </div>
) : (
  <p class="review-report" data-pagefind-ignore>
    <a href={reportUrl.href}>{t['review.report']}</a>
  </p>
)}

<style>
  .review-notice {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
    margin-block: 1rem;
    padding-block: 0.75rem;
    padding-inline: 1rem;
    border: 1px solid currentcolor;
    border-inline-start-width: 0.25rem;
    border-radius: 0.25rem;
  }

  .review-notice p {
    margin: 0;
  }

  /* A reviewed article keeps the way to report an error. */
  .review-report {
    margin-block: 1rem;
  }
</style>
