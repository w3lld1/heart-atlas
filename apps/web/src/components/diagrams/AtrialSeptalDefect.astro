---
import { getMessages } from '../../i18n/messages.ts';

interface Props {
  locale: string;
  /** Unique per diagram on the page; prefixes ids inside the SVG. */
  uid: string;
}

const { locale, uid } = Astro.props;
const t = getMessages(locale);
const arrowV = `${uid}-arrow-v`;
const arrowA = `${uid}-arrow-a`;
// Particles: start position, travel and a negative delay so the flow is already running.
const venous = [0, -0.7, -1.4, -2.1];
const arterial = [-0.35, -1.05, -1.75, -2.45];
const shunt = [0, -1, -2];
---

<svg
  viewBox="0 0 360 300"
  role="img"
  aria-label={t['diagram.atrial-septal-defect.title']}
  lang={locale}
>
  <defs>
    <marker
      id={arrowV}
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="var(--diagram-venous)"></path>
    </marker>
    <marker
      id={arrowA}
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="var(--diagram-arterial)"></path>
    </marker>
  </defs>

  <!-- Heart wall -->
  <path
    d="M60,55 Q180,5 300,55 Q345,140 285,232 Q225,292 180,296 Q135,292 75,232 Q15,140 60,55 Z"
    fill="var(--diagram-muscle)"
  ></path>

  <!-- Chambers: venous blood on the right side of the heart (viewer's left), arterial on the left -->
  <ellipse
    cx="115"
    cy="95"
    rx="58"
    ry="45"
    fill="var(--diagram-venous-fill)"
    stroke="var(--diagram-venous)"
    stroke-width="2"
  ></ellipse>
  <ellipse
    cx="245"
    cy="95"
    rx="58"
    ry="45"
    fill="var(--diagram-arterial-fill)"
    stroke="var(--diagram-arterial)"
    stroke-width="2"
  ></ellipse>
  <ellipse
    class="normal-only"
    cx="120"
    cy="205"
    rx="50"
    ry="58"
    fill="var(--diagram-venous-fill)"
    stroke="var(--diagram-venous)"
    stroke-width="2"
  ></ellipse>
  <!-- With a shunt the right ventricle carries extra volume and is drawn larger. -->
  <ellipse
    class="disease-only"
    cx="114"
    cy="207"
    rx="62"
    ry="64"
    fill="var(--diagram-venous-fill)"
    stroke="var(--diagram-venous)"
    stroke-width="2"
  ></ellipse>
  <!-- After closure the right ventricle is drawn as in Disease: the art changes only what was
       done (the closed defect). The sources do not describe how RV size changes after closure,
       so the drawing does not show a change. -->
  <ellipse
    data-only="treated"
    cx="114"
    cy="207"
    rx="62"
    ry="64"
    fill="var(--diagram-venous-fill)"
    stroke="var(--diagram-venous)"
    stroke-width="2"
  ></ellipse>
  <ellipse
    cx="248"
    cy="205"
    rx="52"
    ry="60"
    fill="var(--diagram-arterial-fill)"
    stroke="var(--diagram-arterial)"
    stroke-width="2"
  ></ellipse>

  <!-- Defect in the atrial septum -->
  <g class="disease-only">
    <rect
      x="168"
      y="84"
      width="24"
      height="22"
      fill="var(--diagram-arterial-fill)"
      stroke="var(--color-text)"
      stroke-width="1.5"
      stroke-dasharray="3 2"
    ></rect>
    <line x1="180" y1="44" x2="180" y2="80" stroke="var(--color-text)" stroke-width="1.5"></line>
    <text x="180" y="36" text-anchor="middle">
      {t['diagram.label.defect']}
    </text>
  </g>

  <!-- After treatment: the defect is closed (a device or a patch, drawn generically); no shunt -->
  <g data-only="treated">
    <rect
      x="166"
      y="82"
      width="28"
      height="26"
      rx="6"
      fill="var(--color-muted)"
      stroke="var(--color-text)"
      stroke-width="1.5"
    ></rect>
    <line x1="180" y1="44" x2="180" y2="80" stroke="var(--color-text)" stroke-width="1.5"></line>
    <text x="180" y="36" text-anchor="middle">
      {t['diagram.label.closed-defect']}
    </text>
  </g>

  <!-- Flow arrows, visible with and without motion -->
  <path
    d="M115,62 L115,222"
    stroke="var(--diagram-venous)"
    stroke-width="3"
    fill="none"
    marker-end={`url(#${arrowV})`}
  ></path>
  <path
    d="M245,62 L245,222"
    stroke="var(--diagram-arterial)"
    stroke-width="3"
    fill="none"
    marker-end={`url(#${arrowA})`}
  ></path>
  <path
    class="disease-only"
    d="M222,95 L140,95"
    stroke="var(--diagram-arterial)"
    stroke-width="3"
    fill="none"
    marker-end={`url(#${arrowA})`}
  ></path>

  <!-- Moving blood -->
  <g class="flow">
    {venous.map((delay) => (
      <circle
        class="asd-down"
        cx="115"
        cy="62"
        r="5"
        fill="var(--diagram-venous)"
        style={`animation-delay: ${delay}s`}
      ></circle>
    ))}
    {arterial.map((delay) => (
      <circle
        class="asd-down"
        cx="245"
        cy="62"
        r="5"
        fill="var(--diagram-arterial)"
        style={`animation-delay: ${delay}s`}
      ></circle>
    ))}
    <g class="disease-only">
      {shunt.map((delay) => (
        <circle
          class="asd-shunt"
          cx="225"
          cy="95"
          r="5"
          fill="var(--diagram-arterial)"
          style={`animation-delay: ${delay}s`}
        ></circle>
      ))}
    </g>
  </g>

  <text x="86" y="100" text-anchor="middle">
    {t['diagram.label.ra']}
  </text>
  <text x="274" y="100" text-anchor="middle">
    {t['diagram.label.la']}
  </text>
  <text x="88" y="212" text-anchor="middle">
    {t['diagram.label.rv']}
  </text>
  <text x="275" y="212" text-anchor="middle">
    {t['diagram.label.lv']}
  </text>
</svg>

<style is:global>
  .diagram .asd-down {
    animation: asd-down 2.8s linear infinite;
  }

  .diagram .asd-shunt {
    animation: asd-shunt 3s linear infinite;
  }

  @keyframes asd-down {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }

    10%,
    85% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translate(0, 155px);
    }
  }

  @keyframes asd-shunt {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }

    10% {
      opacity: 1;
    }

    40% {
      transform: translate(-100px, 0);
    }

    85% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translate(-108px, 120px);
    }
  }
</style>
