---
import { getMessages } from '../../i18n/messages.ts';

interface Props {
  locale: string;
  /** Unique per diagram on the page; prefixes ids inside the SVG. */
  uid: string;
}

const { locale, uid } = Astro.props;
const t = getMessages(locale);
const arrowId = `${uid}-svas-arrow`;
// The valve label is too long for the label column on one line in some locales: split it in two
// at the word boundary that gives the shortest longer line, never leaving a one- or two-letter
// word (a preposition) at the end of the first line.
function twoLines(label: string): [string, string] {
  const words = label.split(' ');
  let best: [string, string] = [label, ''];
  let bestScore = Infinity;
  for (let i = 1; i < words.length; i++) {
    const first = words.slice(0, i).join(' ');
    const second = words.slice(i).join(' ');
    const score =
      Math.max(first.length, second.length) + ((words[i - 1]?.length ?? 0) <= 2 ? 100 : 0);
    if (score < bestScore) {
      bestScore = score;
      best = [first, second];
    }
  }
  return best;
}
const valveLines = twoLines(t['diagram.label.valve-unchanged']);
// Both states show systole: the left ventricle contracts and the aortic valve is open. The valve
// is the same in both states; only the aorta just above the sinuses differs. The aorta runs
// between x = 160 and 240, the valve annulus is at y = 210 and the sinuses bulge out between
// y = 150 and 210. The coronary arteries leave the sinuses at y = 178, below any narrowing.
const lvAndSinuses =
  'C150,156 140,166 142,186 C144,200 152,206 160,210 C150,222 148,238 148,252 C148,286 178,304 200,304 C222,304 252,286 252,252 C252,238 250,222 240,210 C248,206 256,200 258,186 C260,166 250,156 240,150';
// Normal: an even tube above the sinuses.
const normalLumen = `M160,16 L160,150 ${lvAndSinuses} L240,16 Z`;
// Supravalvular stenosis, hourglass form: the aorta is pinched to a waist (x = 182–218) at
// y = 136, just above the sinuses, and is of normal width again above it (no dilation).
const diseaseLumen =
  'M160,16 L160,112 C160,126 182,126 182,136 C182,146 162,146 160,150 ' +
  lvAndSinuses +
  ' C238,146 218,146 218,136 C218,126 240,126 240,112 L240,16 Z';
// Coronary arteries from the sinuses, in a front view: the right one to the viewer's left.
const rca = 'M144,178 C126,176 110,184 100,200 L96,222';
const lca = 'M256,178 C274,176 290,184 300,200 L304,222';
// Blood particles: start column and a delay so the second row trails the first.
const particles = [
  { x: 180, delay: 0 },
  { x: 200, delay: 0 },
  { x: 220, delay: 0 },
  { x: 180, delay: 0.3 },
  { x: 200, delay: 0.3 },
  { x: 220, delay: 0.3 },
];
---

<svg
  viewBox="0 0 500 330"
  role="img"
  aria-label={t['diagram.supravalvular-aortic-stenosis.title']}
  lang={locale}
>
  <defs>
    <marker
      id={arrowId}
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="var(--diagram-arterial)"></path>
    </marker>
  </defs>

  <!-- Phase of the cardiac cycle: the same in both states -->
  <text x="8" y="22">
    {t['diagram.state.systole']}
  </text>

  <!-- Left ventricle wall: the same in both states -->
  <path
    d="M160,210 C136,212 128,236 128,252 C128,296 168,322 200,322 C232,322 272,296 272,252 C272,236 264,212 240,210 Z"
    fill="var(--diagram-muscle)"
    stroke="var(--color-muted)"
    stroke-width="1.5"
  ></path>

  <!-- Coronary arteries: the same in both states, leaving the sinuses below the narrowing -->
  <g fill="none" stroke="var(--diagram-arterial)" stroke-width="5" stroke-linecap="round">
    <path d={rca}></path>
    <path d={lca}></path>
  </g>

  <!-- Lumen of the ventricle, the aortic root and the aorta -->
  <path
    class="normal-only"
    d={normalLumen}
    fill="var(--diagram-arterial-fill)"
    stroke="var(--diagram-arterial)"
    stroke-width="2"
  ></path>
  <path
    class="disease-only"
    d={diseaseLumen}
    fill="var(--diagram-arterial-fill)"
    stroke="var(--diagram-arterial)"
    stroke-width="2"
  ></path>

  <!-- Flow arrows, visible with and without motion -->
  <g fill="none" stroke="var(--diagram-arterial)" stroke-width="3" stroke-linecap="round">
    <g class="normal-only">
      <path d="M180,262 L180,30" marker-end={`url(#${arrowId})`}></path>
      <path d="M200,262 L200,30" marker-end={`url(#${arrowId})`}></path>
      <path d="M220,262 L220,30" marker-end={`url(#${arrowId})`}></path>
    </g>
    <g class="disease-only">
      <!-- Blood converges on the waist above the valve and leaves it as one stream -->
      <path d="M180,262 C180,200 196,170 197,146"></path>
      <path d="M200,262 L200,146"></path>
      <path d="M220,262 C220,200 204,170 203,146"></path>
      <path d="M200,140 L200,30" stroke-width="4" marker-end={`url(#${arrowId})`}></path>
    </g>
  </g>

  <!-- Aortic valve cusps: open in systole, the same in both states -->
  <g class="svas-leaf">
    <g transform="translate(163,210) rotate(-80)">
      <path d="M0,-2.5 Q18,-4 33,-2 Q37,0 33,2 Q18,4 0,2.5 Z"></path>
    </g>
    <g transform="translate(237,210) scale(-1,1) rotate(-80)">
      <path d="M0,-2.5 Q18,-4 33,-2 Q37,0 33,2 Q18,4 0,2.5 Z"></path>
    </g>
  </g>
  <circle cx="160" cy="210" r="3.5" fill="var(--color-muted)"></circle>
  <circle cx="240" cy="210" r="3.5" fill="var(--color-muted)"></circle>

  <!-- Moving blood: an even stream in the normal state, squeezed through the waist in stenosis -->
  <g class="flow">
    <g class="normal-only">
      {particles.map((p) => (
        <circle
          class="svas-p svas-p-normal"
          cx={p.x}
          cy="258"
          r="5"
          fill="var(--diagram-arterial)"
          style={`animation-delay: ${p.delay}s`}
        />
      ))}
    </g>
    <g class="disease-only">
      {particles.map((p) => (
        <circle
          class="svas-p svas-p-waist"
          cx={p.x}
          cy="258"
          r="5"
          fill="var(--diagram-arterial)"
          style={`--svas-dx: ${200 - p.x}px; animation-delay: ${p.delay}s`}
        />
      ))}
    </g>
  </g>

  <!-- Labels inside the drawing -->
  <text x="200" y="284" text-anchor="middle">
    {t['diagram.label.lv']}
  </text>
  <text class="diagram-small" x="8" y="168">
    {t['diagram.label.rca']}
  </text>
  <text class="diagram-small" x="312" y="226">
    {t['diagram.label.lca']}
  </text>

  <!-- Labels in the right column with leader lines into the drawing -->
  <g stroke="var(--color-muted)" stroke-width="1.5">
    <line x1="244" y1="40" x2="306" y2="40"></line>
    <line class="normal-only" x1="244" y1="132" x2="306" y2="132"></line>
    <line class="disease-only" x1="222" y1="136" x2="306" y2="132"></line>
    <line class="disease-only" x1="232" y1="164" x2="306" y2="174"></line>
    <line x1="244" y1="206" x2="306" y2="262"></line>
  </g>
  <text x="312" y="45">
    {t['diagram.label.aorta']}
  </text>
  <text class="normal-only" x="312" y="137">
    {t['diagram.label.wide-lumen']}
  </text>
  <text class="disease-only" x="312" y="137">
    {t['diagram.label.narrowing']}
  </text>
  <text class="diagram-small disease-only" x="312" y="153">
    {t['diagram.label.above-the-valve']}
  </text>
  <text class="diagram-small disease-only" x="312" y="180">
    {t['diagram.label.high-pressure']}
  </text>
  <text x="312" y="267">
    {t['diagram.label.aortic-valve']}
  </text>
  <text class="diagram-small normal-only" x="312" y="285">
    {t['diagram.label.leaflets-open']}
  </text>
  <text class="diagram-small disease-only" x="312" y="285">
    <tspan x="312">{valveLines[0]}</tspan>
    <tspan x="312" dy="14">
      {valveLines[1]}
    </tspan>
  </text>
</svg>

<style is:global>
  .diagram .svas-leaf path {
    fill: var(--color-border);
    stroke: var(--color-muted);
    stroke-width: 2;
  }

  .diagram .svas-p {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }

  .diagram .svas-p-normal {
    animation: svas-normal 2.4s linear infinite;
  }

  .diagram .svas-p-waist {
    animation: svas-waist 2.4s linear infinite;
  }

  /* Normal: an even stream rises through the open valve and up the aorta. */
  @keyframes svas-normal {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }

    8%,
    70% {
      opacity: 1;
    }

    80%,
    100% {
      opacity: 0;
      transform: translate(0, -236px);
    }
  }

  /* Stenosis: the stream passes the normal valve, crowds into the waist above it and leaves it
     as one narrow stream. */
  @keyframes svas-waist {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }

    8% {
      opacity: 1;
    }

    40% {
      transform: translate(calc(var(--svas-dx) * 0.6), -80px);
    }

    52% {
      opacity: 1;
      transform: translate(var(--svas-dx), -128px) scale(0.7, 1.6);
    }

    70% {
      opacity: 1;
    }

    80%,
    100% {
      opacity: 0;
      transform: translate(var(--svas-dx), -236px) scale(0.7, 1.6);
    }
  }
</style>
