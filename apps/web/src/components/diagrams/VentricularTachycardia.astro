---
import { getMessages } from '../../i18n/messages.ts';

interface Props {
  locale: string;
  /** Unique per diagram on the page; prefixes ids inside the SVG. */
  uid: string;
}

const { locale, uid } = Astro.props;
const t = getMessages(locale);
const arrowId = `${uid}-vt-arrow`;

/*
 * A flat pathway scheme, not a heart outline: atria on top, the AV node between, the ventricles as
 * a large band below. Normal: one impulse from the SA node goes through the AV node down to the
 * ventricles once per beat. Disease (scar-related re-entry): a closed circuit in the scar zone of
 * the ventricular wall with a narrow isthmus; every lap excites the ventricles again, so they beat
 * fast and evenly on their own, apart from the atria and the AV node. The route from the SA node
 * stays as a faint dashed line that ends at the AV node.
 */
// Normal route: SA node across the atria into the AV node and down into the ventricles.
const normalRoute = 'M70,44 Q150,72 220,110 L220,182';
// From the end of the route the impulse spreads into both sides of the ventricles.
const spreadLeft = 'M220,182 Q160,206 112,278';
const spreadRight = 'M220,182 Q280,206 328,278';
// Re-entry circuit around the scar: the isthmus is the narrow bottom stretch, run left to right,
// then up the right side, back over the top and down the left side.
const isthmus = 'M282,286 L338,286';
const circuitUp = 'M338,286 C404,286 404,176 310,176';
const circuitDown = 'M310,176 C216,176 216,286 282,286';
// The whole circuit as one closed path for the moving impulse (isthmus first).
const circuit = 'M282,286 L338,286 C404,286 404,176 310,176 C216,176 216,286 282,286';
// Each lap sends the impulse out of the circuit into the rest of the ventricles.
const exitLeft = 'M240,212 Q170,200 96,226';
const exitDown = 'M240,250 Q170,270 96,300';
// In tachycardia the atria still get the impulse from the SA node, but it is not what drives the
// ventricles.
const atrialRoute = 'M70,44 Q150,72 220,110';
---

<svg
  viewBox="0 0 440 352"
  role="img"
  aria-label={t['diagram.ventricular-tachycardia.title']}
  lang={locale}
>
  <defs>
    <marker
      id={arrowId}
      viewBox="0 0 10 10"
      refX="7"
      refY="5"
      markerWidth="4"
      markerHeight="4"
      orient="auto-start-reverse"
    >
      <path
        d="M0,0 L10,5 L0,10 z"
        fill="var(--diagram-impulse)"
        stroke="var(--color-text)"
        stroke-width="1"
        stroke-opacity="0.6"
      ></path>
    </marker>
  </defs>

  <!-- Atria on top, ventricles below -->
  <rect x="16" y="16" width="408" height="78" rx="16" fill="var(--diagram-muscle)"></rect>
  <rect x="16" y="140" width="408" height="200" rx="16" fill="var(--diagram-muscle)"></rect>

  <!-- Ventricles light up on each beat: once per cycle normally, on every lap of the circuit in
       tachycardia -->
  <g class="flow">
    <rect
      class="vt-beat vt-beat-normal normal-only"
      x="16"
      y="140"
      width="408"
      height="200"
      rx="16"
    ></rect>
    <rect
      class="vt-beat vt-beat-fast disease-only"
      x="16"
      y="140"
      width="408"
      height="200"
      rx="16"
    ></rect>
  </g>

  <!-- Normal: the impulse comes from the SA node through the AV node and spreads in the ventricles -->
  <g class="normal-only">
    <path class="vt-mark" d={normalRoute}></path>
    <path class="vt-mark" d={spreadLeft} marker-end={`url(#${arrowId})`}></path>
    <path class="vt-mark" d={spreadRight} marker-end={`url(#${arrowId})`}></path>
    <g class="flow">
      <path class="vt-run vt-run-route" d={normalRoute} pathLength="100"></path>
      <path class="vt-run vt-run-spread" d={spreadLeft} pathLength="100"></path>
      <path class="vt-run vt-run-spread" d={spreadRight} pathLength="100"></path>
    </g>
  </g>

  <!-- Tachycardia: the atrial route is no longer what drives the ventricles -->
  <g class="disease-only">
    <path class="vt-mark vt-mark-faint" d={atrialRoute}></path>
    <!-- Scar in the ventricular wall -->
    <ellipse class="vt-scar" cx="310" cy="231" rx="58" ry="34"></ellipse>
    <!-- Re-entry circuit around it; the isthmus is a narrow channel with walls on both sides -->
    <path class="vt-wall" d="M282,278 L338,278 M282,294 L338,294"></path>
    <path class="vt-mark" d={isthmus}></path>
    <path class="vt-mark" d={circuitUp} marker-end={`url(#${arrowId})`}></path>
    <path class="vt-mark" d={circuitDown} marker-end={`url(#${arrowId})`}></path>
    <path class="vt-mark vt-mark-thin" d={exitLeft} marker-end={`url(#${arrowId})`}></path>
    <path class="vt-mark vt-mark-thin" d={exitDown} marker-end={`url(#${arrowId})`}></path>
    <g class="flow">
      <path class="vt-run vt-run-circuit" d={circuit} pathLength="100"></path>
      <path class="vt-run vt-run-exit" d={exitLeft} pathLength="100"></path>
      <path class="vt-run vt-run-exit" d={exitDown} pathLength="100"></path>
    </g>
  </g>

  <!-- Nodes -->
  <circle class="vt-node" cx="70" cy="44" r="7"></circle>
  <ellipse class="vt-node" cx="220" cy="117" rx="14" ry="9"></ellipse>

  <!-- Labels -->
  <text x="86" y="36">
    {t['diagram.label.sa-node']}
  </text>
  <text x="30" y="88">
    {t['diagram.label.atria']}
  </text>
  <text x="242" y="123">
    {t['diagram.label.av-node']}
  </text>
  <text class="diagram-small disease-only" x="310" y="236" text-anchor="middle">
    {t['diagram.label.scar']}
  </text>
  <text class="diagram-small disease-only" x="310" y="312" text-anchor="middle">
    {t['diagram.label.isthmus']}
  </text>
  <text x="30" y="168">
    {t['diagram.label.ventricles']}
  </text>
  <text class="diagram-small normal-only" x="30" y="328">
    {t['diagram.label.normal-rhythm']}
  </text>
  <text class="diagram-small disease-only" x="30" y="328">
    {t['diagram.label.fast-regular-rhythm']}
  </text>
</svg>

<style is:global>
  .diagram .vt-node {
    fill: var(--diagram-impulse);
    stroke: var(--color-text);
    stroke-width: 1.5;
  }

  .diagram .vt-mark {
    fill: none;
    stroke: var(--diagram-impulse);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .diagram .vt-mark-thin {
    stroke-width: 3;
  }

  /* The atria still beat on their own, but this route no longer drives the ventricles. */
  .diagram .vt-mark-faint {
    stroke-width: 2;
    stroke-dasharray: 4 6;
    stroke-linecap: butt;
    opacity: 0.6;
  }

  /* Walls of the isthmus: they show the narrow part of the circuit without motion. */
  .diagram .vt-wall {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 2;
  }

  .diagram .vt-scar {
    fill: var(--color-bg);
    stroke: var(--color-text);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }

  /* The moving impulse: a short dash that runs along its path (pathLength is 100). */
  .diagram .vt-run {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 8 92;
    stroke-dashoffset: 0;
    opacity: 0;
  }

  .diagram .vt-run-route {
    animation: vt-run-route 1s linear infinite;
  }

  .diagram .vt-run-spread {
    animation: vt-run-spread 1s linear infinite;
  }

  .diagram .vt-run-circuit {
    opacity: 1;
    animation: vt-run-circuit 0.5s linear infinite;
  }

  .diagram .vt-run-exit {
    animation: vt-run-exit 0.5s linear infinite;
  }

  .diagram .vt-beat {
    fill: var(--diagram-impulse);
    opacity: 0;
  }

  .diagram .vt-beat-normal {
    animation: vt-beat-normal 1s linear infinite;
  }

  .diagram .vt-beat-fast {
    animation: vt-beat-fast 0.5s linear infinite;
  }

  /* Normal: SA node to the AV node and down (first 35 %), then into the ventricles, then a pause. */
  @keyframes vt-run-route {
    0% {
      opacity: 1;
      stroke-dashoffset: 0;
    }

    35% {
      opacity: 1;
      stroke-dashoffset: -92;
    }

    36%,
    100% {
      opacity: 0;
      stroke-dashoffset: -92;
    }
  }

  @keyframes vt-run-spread {
    0%,
    35% {
      opacity: 0;
      stroke-dashoffset: 0;
    }

    36% {
      opacity: 1;
      stroke-dashoffset: 0;
    }

    55% {
      opacity: 1;
      stroke-dashoffset: -92;
    }

    56%,
    100% {
      opacity: 0;
      stroke-dashoffset: -92;
    }
  }

  @keyframes vt-beat-normal {
    0%,
    54% {
      opacity: 0;
    }

    58% {
      opacity: 0.45;
    }

    80%,
    100% {
      opacity: 0;
    }
  }

  /* Tachycardia: one lap of the circuit every 0.5 s (120 per minute), without a pause. */
  @keyframes vt-run-circuit {
    from {
      stroke-dashoffset: 0;
    }

    to {
      stroke-dashoffset: -100;
    }
  }

  /* About 70 % into the lap the impulse is at the left side and also leaves the circuit. */
  @keyframes vt-run-exit {
    0%,
    69% {
      opacity: 0;
      stroke-dashoffset: 0;
    }

    70% {
      opacity: 1;
      stroke-dashoffset: 0;
    }

    98% {
      opacity: 1;
      stroke-dashoffset: -92;
    }

    99%,
    100% {
      opacity: 0;
      stroke-dashoffset: -92;
    }
  }

  @keyframes vt-beat-fast {
    0%,
    86% {
      opacity: 0;
    }

    94% {
      opacity: 0.45;
    }

    100% {
      opacity: 0.1;
    }
  }
</style>
