---
import { getMessages } from '../../i18n/messages.ts';

interface Props {
  locale: string;
  /** Unique per diagram on the page; prefixes ids inside the SVG. */
  uid: string;
}

const { locale, uid } = Astro.props;
const t = getMessages(locale);
const arrow = `${uid}-tak-arrow`;
// Long labels do not fit their free space on one line: split them in two at a word boundary.
function twoLines(label: string): [string, string] {
  const words = label.split(' ');
  const split = Math.ceil(words.length / 2);
  return [words.slice(0, split).join(' '), words.slice(split).join(' ')];
}
const trunkLines = twoLines(t['diagram.label.brachiocephalic-trunk']);
const subclavianLines = twoLines(t['diagram.label.left-subclavian']);
const wallLines = twoLines(t['diagram.label.thick-wall']);
const narrowedLines = twoLines(t['diagram.label.narrowed-origin']);
const blockedLines = twoLines(t['diagram.label.blocked-origin']);
// Front view of the aortic arch, so the right side of the body is on the left of the picture. The
// ascending aorta rises at x = 170, the arch runs along y = 170 and the descending aorta goes down
// at x = 370. Vessels are wide strokes: the wall, then the lumen on top of it.
const arch = 'Q170,170 230,170 H310 Q370,170 370,230';
const aorta = `M170,460 V230 ${arch} V460`;
// The three branches of the arch: the brachiocephalic trunk (x = 232), which divides into the right
// common carotid and right subclavian arteries, the left common carotid artery (x = 270) and the
// left subclavian artery (x = 308). The subclavian arteries run out to the arms at y = 70.
const branches = [
  'M232,170 V110',
  'M232,116 V24',
  'M232,112 Q232,70 196,70 H16',
  'M270,170 V24',
  'M308,170 V112 Q308,70 344,70 H504',
];
// Lumens of the branches open into the lumen of the aorta (they start inside it, at y = 180).
const normalLumens = [
  'M232,180 V110',
  'M232,116 V24',
  'M232,112 Q232,70 196,70 H16',
  'M270,180 V24',
  'M308,180 V112 Q308,70 344,70 H504',
];
// Disease: the wall at the origin of each branch is thickened.
const inflamedOrigins = ['M232,166 V128', 'M270,166 V128', 'M308,166 V128'];
// Disease lumens: the brachiocephalic trunk is narrowed at its origin, the left common carotid keeps
// its normal lumen, and the origin of the left subclavian artery is closed: its lumen starts only
// above the thickened wall.
const diseaseLumens = [
  { d: 'M232,180 V128', width: 3 },
  { d: 'M232,130 V110', width: 10 },
  { d: 'M232,116 V24', width: 10 },
  { d: 'M232,112 Q232,70 196,70 H16', width: 10 },
  { d: 'M270,180 V24', width: 10 },
  { d: 'M308,130 V112 Q308,70 344,70 H504', width: 10 },
];
const flow = {
  main: `M170,450 V230 ${arch} V444`,
  rightCarotid: 'M232,150 V32',
  rightArm: 'M214,70 H24',
  leftCarotid: 'M270,150 V32',
  leftArm: 'M326,70 H496',
};
---

<svg
  viewBox="0 0 520 460"
  role="img"
  aria-label={t['diagram.takayasu-arteritis.title']}
  lang={locale}
>
  <defs>
    <marker
      id={arrow}
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="4"
      markerHeight="4"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="var(--diagram-arterial)"></path>
    </marker>
  </defs>

  <!-- Vessel walls. In disease the wall of the aorta and of the branch origins is thickened. -->
  <g fill="none" stroke="var(--diagram-arterial)">
    {branches.map((d) => (
      <path d={d} stroke-width="16" />
    ))}
    <path class="normal-only" d={aorta} stroke-width="34"></path>
    <g class="disease-only">
      {inflamedOrigins.map((d) => (
        <path d={d} stroke-width="24" />
      ))}
      <path d={aorta} stroke-width="46"></path>
    </g>
  </g>

  <!-- Lumens on top of the walls, opening into each other -->
  <g fill="none" stroke="var(--diagram-arterial-fill)">
    <g class="normal-only">
      {normalLumens.map((d) => (
        <path d={d} stroke-width="10" />
      ))}
      <path d={aorta} stroke-width="26"></path>
    </g>
    <g class="disease-only">
      {diseaseLumens.map((lumen) => (
        <path d={lumen.d} stroke-width={lumen.width} />
      ))}
      <path d={aorta} stroke-width="22"></path>
    </g>
  </g>

  <!-- Flow arrows, visible with and without motion. In disease less blood passes the narrowed
       trunk and none passes the closed origin of the left subclavian artery. -->
  <g fill="none" stroke="var(--diagram-arterial)" stroke-linecap="round">
    <path d={flow.main} stroke-width="4" marker-end={`url(#${arrow})`}></path>
    <path d={flow.leftCarotid} stroke-width="3" marker-end={`url(#${arrow})`}></path>
    <g class="normal-only" stroke-width="3">
      <path d={flow.rightCarotid} marker-end={`url(#${arrow})`}></path>
      <path d={flow.rightArm} marker-end={`url(#${arrow})`}></path>
      <path d={flow.leftArm} marker-end={`url(#${arrow})`}></path>
    </g>
    <g class="disease-only" stroke-width="1.5">
      <path d={flow.rightCarotid} marker-end={`url(#${arrow})`}></path>
      <path d={flow.rightArm} marker-end={`url(#${arrow})`}></path>
    </g>
  </g>

  <!-- Moving blood: dashes running along the arrows -->
  <g class="flow" stroke="var(--color-bg)">
    <path class="dash-flow" d={flow.main} stroke-width="2"></path>
    <path class="dash-flow" d={flow.leftCarotid} stroke-width="1.5"></path>
    <g class="normal-only">
      <path class="dash-flow" d={flow.rightCarotid} stroke-width="1.5"></path>
      <path class="dash-flow" d={flow.rightArm} stroke-width="1.5"></path>
      <path class="dash-flow" d={flow.leftArm} stroke-width="1.5"></path>
    </g>
    <g class="disease-only">
      <path class="dash-flow" d={flow.rightCarotid} stroke-width="0.75"></path>
      <path class="dash-flow" d={flow.rightArm} stroke-width="0.75"></path>
    </g>
  </g>

  <!-- Leader lines from the labels in the side columns -->
  <g stroke="var(--color-text)" stroke-width="1.5">
    <line x1="140" y1="136" x2="220" y2="136"></line>
    <line x1="320" y1="136" x2="380" y2="136"></line>
    <line class="disease-only" x1="140" y1="268" x2="156" y2="268"></line>
  </g>

  <!-- Arms: which side, and the pulse on each -->
  <text class="diagram-small" x="8" y="100">
    {t['diagram.label.right-arm']}
  </text>
  <text class="diagram-small normal-only" x="8" y="116">
    {t['diagram.label.pulse-normal']}
  </text>
  <text class="diagram-small disease-only" x="8" y="116">
    {t['diagram.label.pulse-weak']}
  </text>
  <text class="diagram-small" x="512" y="100" text-anchor="end">
    {t['diagram.label.left-arm']}
  </text>
  <text class="diagram-small normal-only" x="512" y="116" text-anchor="end">
    {t['diagram.label.pulse-normal']}
  </text>
  <text class="diagram-small disease-only" x="512" y="116" text-anchor="end">
    {t['diagram.label.pulse-weak-or-absent']}
  </text>

  <!-- Branches of the arch -->
  <text class="diagram-small" x="282" y="40">
    {t['diagram.label.left-common-carotid']}
  </text>
  <text class="diagram-small" x="8" y="140">
    <tspan x="8">{trunkLines[0]}</tspan>
    <tspan x="8" dy="15">
      {trunkLines[1]}
    </tspan>
  </text>
  <text class="diagram-small" x="512" y="140" text-anchor="end">
    <tspan x="512">{subclavianLines[0]}</tspan>
    <tspan x="512" dy="15">
      {subclavianLines[1]}
    </tspan>
  </text>
  <text class="disease-only" x="8" y="178">
    <tspan x="8">{narrowedLines[0]}</tspan>
    <tspan x="8" dy="17">
      {narrowedLines[1]}
    </tspan>
  </text>
  <text class="disease-only" x="512" y="178" text-anchor="end">
    <tspan x="512">{blockedLines[0]}</tspan>
    <tspan x="512" dy="17">
      {blockedLines[1]}
    </tspan>
  </text>

  <!-- The aorta and its wall -->
  <text class="diagram-small" x="140" y="340" text-anchor="end">
    {t['diagram.label.aorta']}
  </text>
  <text class="diagram-small disease-only" x="136" y="264" text-anchor="end">
    <tspan x="136">{wallLines[0]}</tspan>
    <tspan x="136" dy="15">
      {wallLines[1]}
    </tspan>
  </text>
</svg>
