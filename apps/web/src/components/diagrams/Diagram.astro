---
import { defaultLocale } from '../../i18n/locales.ts';
import { getMessages } from '../../i18n/messages.ts';
import { diagramStates, diagrams, stateIds, type DiagramName } from './index.ts';

interface Props {
  name: DiagramName;
}

const { name } = Astro.props;
const Art = diagrams[name];
if (!Art) throw new Error(`Unknown diagram "${name}"`);
const { states, initial } = diagramStates(name);
const locale = Astro.locals.locale ?? defaultLocale;
const t = getMessages(locale);
// A unique id per diagram on the page keeps radio groups and SVG ids apart.
Astro.locals.diagramCount = (Astro.locals.diagramCount ?? 0) + 1;
const id = `diagram-${Astro.locals.diagramCount}`;
// One rule per state id: in that state, everything marked for another state is hidden. Scoped
// styles cannot come from data, so the rules go into the page once, with the first diagram.
const stateRules =
  Astro.locals.diagramCount === 1
    ? stateIds
        .map(
          (state) =>
            `.diagram:has([value='${state}']:checked) [data-only]:not([data-only='${state}']){display:none}`,
        )
        .join('')
    : '';
// Captions are article text in a slot per state, e.g. <p slot="systole">. A slot for a state the
// diagram does not have would vanish silently, so it fails the build. The default slot is the
// whitespace MDX leaves between captions.
for (const slot of Object.keys(Astro.slots).filter((key) => key !== 'default')) {
  if (!(states as readonly string[]).includes(slot)) {
    throw new Error(`<Diagram name="${name}">: no state "${slot}" (states: ${states.join(', ')})`);
  }
}
const captions = await Promise.all(
  states.map(async (state) => ({
    state,
    html: Astro.slots.has(state) ? await Astro.slots.render(state) : '',
  })),
);
---

<figure class="diagram">
  <!-- Controls and labels are UI text in the page locale; captions are article text. -->
  <div class="diagram-controls" lang={locale}>
    {states.length > 1 && (
      <fieldset>
        <legend class="diagram-visually-hidden">{t['diagram.state']}</legend>
        {states.map((state) => (
          <label>
            <input type="radio" name={`${id}-state`} value={state} checked={state === initial} />
            {t[`diagram.state.${state}`]}
          </label>
        ))}
      </fieldset>
    )}
    <label class="diagram-pause">
      <input type="checkbox" />
      {t['diagram.pause']}
    </label>
  </div>
  <Art locale={locale} uid={id} />
  <figcaption>
    {captions.map(({ state, html }) => (
      <div class="diagram-caption" data-only={state} set:html={html} />
    ))}
    <p class="diagram-note" lang={locale}>
      {t['diagram.schematic']}
    </p>
  </figcaption>
</figure>

<style is:global>
  .diagram {
    --diagram-arterial: #c62828;
    --diagram-venous: #1f5fae;
    --diagram-arterial-fill: #f9d7d7;
    --diagram-venous-fill: #d6e3f5;
    --diagram-muscle: #e8b4a8;
    --diagram-impulse: #e3a400;
    --diagram-plaque: #e9be4f;

    margin-block: 1.5rem;
    margin-inline: 0;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .diagram {
      --diagram-arterial: #ff6b6b;
      --diagram-venous: #6fa8ff;
      --diagram-arterial-fill: #4a2326;
      --diagram-venous-fill: #1f2f4a;
      --diagram-muscle: #6b3a33;
      --diagram-impulse: #ffd24d;
      --diagram-plaque: #b8923a;
    }
  }

  /* Labels sit at fixed points of the art, which is never mirrored, so text anchors must not flip. */
  .diagram svg {
    direction: ltr;
    display: block;
    inline-size: 100%;
    max-inline-size: 32rem;
    block-size: auto;
    margin-inline: auto;
  }

  .diagram svg text {
    fill: var(--color-text);
    font-family: system-ui, sans-serif;
    font-size: 16px;
    font-weight: 600;
  }

  .diagram svg text.diagram-small {
    font-size: 12px;
    font-weight: 500;
  }

  /* Moving dashes along a vessel or pathway: the shared flow animation of the diagrams. */
  .diagram .dash-flow {
    animation: diagram-dash 1.4s linear infinite;
    fill: none;
    stroke-dasharray: 4 12;
    stroke-linecap: round;
  }

  @keyframes diagram-dash {
    to {
      stroke-dashoffset: -32;
    }
  }

  .diagram-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    margin-block-end: 0.75rem;
  }

  .diagram-controls fieldset {
    display: inline-flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    overflow: hidden;
  }

  .diagram-controls fieldset label {
    padding-block: 0.375rem;
    padding-inline: 1rem;
    cursor: pointer;
  }

  .diagram-controls fieldset label:has(:checked) {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  /* Inside the label: the rounded fieldset clips anything drawn outside it. */
  .diagram-controls fieldset label:has(:focus-visible) {
    outline: 2px solid currentcolor;
    outline-offset: -4px;
  }

  .diagram-controls fieldset input {
    position: absolute;
    opacity: 0;
  }

  .diagram-pause {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    cursor: pointer;
  }

  .diagram-note {
    margin-block-start: 0.5rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .diagram-visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The state is pure CSS, so the toggle works without JavaScript. Elements marked
     data-only="<state>" (or the older normal-only / disease-only classes) show only in it. */
  .diagram:has([value='normal']:checked) .disease-only,
  .diagram:has([value='disease']:checked) .normal-only {
    display: none;
  }

  .diagram:has(.diagram-pause :checked) svg * {
    animation-play-state: paused;
  }

  /* Without motion the arrows in each diagram carry the same meaning. */
  @media (prefers-reduced-motion: reduce) {
    .diagram svg * {
      animation: none !important;
    }

    .diagram svg .flow {
      display: none;
    }

    .diagram-pause {
      display: none;
    }
  }
</style>

{stateRules && <Fragment set:html={`<style>${stateRules}</style>`} />}
