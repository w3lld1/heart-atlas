---
import { getMessages } from '../../i18n/messages.ts';

interface Props {
  locale: string;
  /** Unique per diagram on the page; prefixes ids inside the SVG. */
  uid: string;
}

const { locale, uid } = Astro.props;
const t = getMessages(locale);
const arrow = `${uid}-vv-arrow`;
// Long labels do not fit their free space on one line: split them in two at a word boundary.
function twoLines(label: string): [string, string] {
  const words = label.split(' ');
  const split = Math.ceil(words.length / 2);
  return [words.slice(0, split).join(' '), words.slice(split).join(' ')];
}
const deepVeinLines = twoLines(t['diagram.label.leg-vein']);
const connectingLines = twoLines(t['diagram.label.connecting-vein']);
const cuspsLines = twoLines(t['diagram.label.cusps-apart']);
const dilatedLines = twoLines(t['diagram.label.dilated-tortuous-vein']);
// A segment of the leg in long section; the heart is up. From left to right: the skin, the
// superficial vein in the fat under it, the muscle with the deep vein, and a short connecting vein
// between the two veins. Vessels are wide strokes: the wall, then the lumen on top of it.
const superficialNormal = 'M215,20 V400';
// In disease the superficial vein is wider, and between its valves it is longer and twisted.
const superficialDisease =
  'M215,20 V140 C215,178 252,168 252,202 C252,236 178,222 178,258 C178,290 215,280 215,312 V400';
const deepVein = 'M335,20 V400';
// It reaches into the lumens of both veins, so its lumen, drawn after their walls, opens into them.
const connecting = 'M218,374.4 L326,309.6';
// Valves of the superficial vein sit on its straight parts, the same in both states.
const valveYs = [118, 340];
// Normal: two cusps whose edges meet in the middle of the vein.
const closedCusps = valveYs.flatMap((y) => [
  `M209,${y} Q211.5,${y - 8} 214,${y - 15}`,
  `M221,${y} Q218.5,${y - 8} 216,${y - 15}`,
]);
// Disease: the vein is wider and the same cusps no longer reach each other.
const apartCusps = valveYs.flatMap((y) => [
  `M203,${y} Q207,${y - 8} 210,${y - 14}`,
  `M227,${y} Q223,${y - 8} 220,${y - 14}`,
]);
// Valves of the deep vein work normally in both states: their cusps meet as well.
const deepCusps = [130, 270].flatMap((y) => [
  `M323,${y} Q327.5,${y - 9} 333.5,${y - 18}`,
  `M347,${y} Q342.5,${y - 9} 336.5,${y - 18}`,
]);
// Routes of the moving blood.
const upSuperficial = 'M215,396 V24';
const upDeep = 'M335,396 V24';
const downSuperficial =
  'M215,24 V140 C215,178 252,168 252,202 C252,236 178,222 178,258 C178,290 215,280 215,312 V396';
// Negative delays so the flow is already running when the page opens.
const rising = [0, -1.2, -2.4];
const falling = [0, -2.5];
---

<svg viewBox="0 0 520 410" role="img" aria-label={t['diagram.varicose-veins.title']} lang={locale}>
  <defs>
    <marker
      id={arrow}
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="4"
      markerHeight="4"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="var(--diagram-venous)"></path>
    </marker>
  </defs>

  <!-- Direction to the heart, the same in both states -->
  <path
    d="M40,64 V34"
    fill="none"
    stroke="var(--diagram-venous)"
    stroke-width="3"
    marker-end={`url(#${arrow})`}
  ></path>
  <text x="8" y="24">
    {t['diagram.label.to-heart']}
  </text>

  <!-- Skin and the muscle around the deep vein -->
  <path d="M150,40 V400" stroke="var(--color-muted)" stroke-width="3"></path>
  <rect
    x="288"
    y="20"
    width="94"
    height="380"
    rx="10"
    fill="var(--diagram-muscle)"
    stroke="var(--color-muted)"
    stroke-width="1.5"
  ></rect>

  <!-- Connecting vein from the superficial vein into the deep one: its wall goes under the veins -->
  <path d={connecting} stroke="var(--diagram-venous)" stroke-width="14"></path>

  <!-- Deep vein: normal in both states -->
  <path d={deepVein} stroke="var(--diagram-venous)" stroke-width="30"></path>
  <path d={deepVein} stroke="var(--diagram-venous-fill)" stroke-width="24"></path>

  <!-- Superficial vein: narrow and straight; in disease wide and twisted -->
  <g class="normal-only">
    <path d={superficialNormal} stroke="var(--diagram-venous)" stroke-width="18"></path>
    <path d={superficialNormal} stroke="var(--diagram-venous-fill)" stroke-width="12"></path>
  </g>
  <g class="disease-only" fill="none">
    <path d={superficialDisease} stroke="var(--diagram-venous)" stroke-width="30"></path>
    <path d={superficialDisease} stroke="var(--diagram-venous-fill)" stroke-width="24"></path>
  </g>

  <!-- Lumen of the connecting vein, open into both veins -->
  <path d={connecting} stroke="var(--diagram-venous-fill)" stroke-width="9"></path>

  <!-- Valve cusps -->
  <g fill="none" stroke="var(--color-muted)" stroke-width="3" stroke-linecap="round">
    {deepCusps.map((d) => (
      <path d={d} />
    ))}
    <g class="normal-only">
      {closedCusps.map((d) => (
        <path d={d} />
      ))}
    </g>
    <g class="disease-only">
      {apartCusps.map((d) => (
        <path d={d} />
      ))}
    </g>
  </g>

  <!-- Flow arrows, visible with and without motion: up in the deep vein and from the superficial
       vein into it; in the superficial vein up in the normal state and down in disease -->
  <g fill="none" stroke="var(--diagram-venous)" stroke-width="3" marker-end={`url(#${arrow})`}>
    <path d="M335,240 V196"></path>
    <path d="M335,96 V52"></path>
    <path d="M250,355 L290,331" stroke-width="2.5"></path>
    <path class="normal-only" d="M215,260 V216"></path>
    <path class="normal-only" d="M215,82 V44"></path>
    <path class="disease-only" d="M215,44 V90"></path>
    <path class="disease-only" d="M215,352 V392"></path>
  </g>

  <!-- Moving blood -->
  <g class="flow" fill="var(--diagram-venous)">
    {rising.map((delay) => (
      <circle
        class="vv-run"
        r="3.5"
        style={`offset-path: path('${upDeep}'); animation-duration: 3.6s; animation-delay: ${delay}s`}
      />
    ))}
    <g class="normal-only">
      {rising.map((delay) => (
        <circle
          class="vv-run"
          r="3"
          style={`offset-path: path('${upSuperficial}'); animation-duration: 4.2s; animation-delay: ${delay}s`}
        />
      ))}
    </g>
    <g class="disease-only">
      {falling.map((delay) => (
        <circle
          class="vv-run"
          r="3.5"
          style={`offset-path: path('${downSuperficial}'); animation-duration: 5s; animation-delay: ${delay}s`}
        />
      ))}
    </g>
  </g>

  <!-- Leader lines -->
  <g stroke="var(--color-text)" stroke-width="1.5">
    <line x1="142" y1="160" x2="150" y2="160"></line>
    <line x1="142" y1="96" x2="204" y2="96"></line>
    <line x1="388" y1="60" x2="366" y2="60"></line>
    <line x1="388" y1="160" x2="352" y2="160"></line>
    <line x1="388" y1="300" x2="290" y2="324"></line>
    <g class="normal-only">
      <line x1="142" y1="226" x2="208" y2="112"></line>
      <line x1="142" y1="230" x2="208" y2="334"></line>
    </g>
    <g class="disease-only">
      <line x1="142" y1="234" x2="164" y2="252"></line>
      <line x1="142" y1="330" x2="204" y2="330"></line>
      <line x1="142" y1="372" x2="204" y2="372"></line>
    </g>
  </g>

  <!-- Labels: the left column ends at the skin, the right column starts after the muscle -->
  <text class="diagram-small" x="138" y="164" text-anchor="end">
    {t['diagram.label.skin']}
  </text>
  <text class="diagram-small" x="138" y="100" text-anchor="end">
    {t['diagram.label.superficial-vein']}
  </text>
  <text class="diagram-small" x="392" y="64">
    {t['diagram.label.muscle']}
  </text>
  <text class="diagram-small" x="392" y="156">
    <tspan x="392">{deepVeinLines[0]}</tspan>
    <tspan x="392" dy="15">
      {deepVeinLines[1]}
    </tspan>
  </text>
  <text class="diagram-small" x="392" y="296">
    <tspan x="392">{connectingLines[0]}</tspan>
    <tspan x="392" dy="15">
      {connectingLines[1]}
    </tspan>
  </text>
  <text class="diagram-small normal-only" x="138" y="232" text-anchor="end">
    {t['diagram.label.valves']}
  </text>
  <g class="disease-only">
    <text class="diagram-small" x="138" y="226" text-anchor="end">
      <tspan x="138">{dilatedLines[0]}</tspan>
      <tspan x="138" dy="15">
        {dilatedLines[1]}
      </tspan>
    </text>
    <text class="diagram-small" x="138" y="326" text-anchor="end">
      <tspan x="138">{cuspsLines[0]}</tspan>
      <tspan x="138" dy="15">
        {cuspsLines[1]}
      </tspan>
    </text>
    <text class="diagram-small" x="138" y="376" text-anchor="end">
      {t['diagram.label.backflow']}
    </text>
  </g>
</svg>

<style is:global>
  .diagram .vv-run {
    offset-rotate: 0deg;
    animation-name: vv-run;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  /* Without offset-path the particles would sit at the corner of the picture. */
  @supports not (offset-path: path('M0,0')) {
    .diagram .vv-run {
      display: none;
    }
  }

  /* Blood moves along its route: up the veins in the normal state, down the superficial vein in
     disease. */
  @keyframes vv-run {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }

    6%,
    90% {
      opacity: 1;
    }

    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }
</style>
