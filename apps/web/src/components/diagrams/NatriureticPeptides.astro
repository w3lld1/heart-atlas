---
import { getMessages } from '../../i18n/messages.ts';

interface Props {
  locale: string;
  /** Unique per diagram on the page; prefixes ids inside the SVG. */
  uid: string;
}

const { locale, uid } = Astro.props;
const t = getMessages(locale);
const arrow = `${uid}-arrow`;
---

<!--
  How one precursor becomes two measurable molecules. No numbers or thresholds on purpose: a
  scale would turn the picture into a self-diagnosis tool.
-->
<svg
  viewBox="0 0 400 230"
  role="img"
  aria-label={t['diagram.natriuretic-peptides.title']}
  lang={locale}
>
  <defs>
    <marker
      id={arrow}
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="var(--color-text)"></path>
    </marker>
  </defs>

  <!-- Ventricle muscle cell releasing the precursor -->
  <rect
    x="10"
    y="70"
    width="120"
    height="90"
    rx="40"
    fill="var(--diagram-muscle)"
    stroke="var(--color-border)"
  ></rect>
  <text class="diagram-small" x="70" y="105" text-anchor="middle">
    {t['diagram.label.ventricleCell']}
  </text>
  <g>
    <rect
      class="peptide-release"
      x="35"
      y="118"
      width="70"
      height="28"
      rx="14"
      fill="var(--color-bg)"
      stroke="var(--diagram-impulse)"
      stroke-width="4"
    ></rect>
    <text class="diagram-small" x="70" y="137" text-anchor="middle">
      proBNP
    </text>
  </g>

  <!-- Cleavage into two parts -->
  <g fill="none" stroke="var(--color-text)" stroke-width="2">
    <path d="M132,115 L240,60" marker-end={`url(#${arrow})`}></path>
    <path d="M132,115 L240,170" marker-end={`url(#${arrow})`}></path>
  </g>
  <text class="diagram-small" x="176" y="120" text-anchor="middle">
    {t['diagram.label.cleavage']}
  </text>

  <rect
    x="245"
    y="30"
    width="145"
    height="60"
    rx="10"
    fill="var(--diagram-arterial-fill)"
    stroke="var(--diagram-arterial)"
    stroke-width="2"
  ></rect>
  <text x="317" y="55" text-anchor="middle">
    BNP
  </text>
  <text class="diagram-small" x="317" y="76" text-anchor="middle">
    {t['diagram.label.activeHormone']}
  </text>

  <rect
    x="245"
    y="140"
    width="145"
    height="60"
    rx="10"
    fill="var(--diagram-venous-fill)"
    stroke="var(--diagram-venous)"
    stroke-width="2"
  ></rect>
  <text x="317" y="165" text-anchor="middle">
    NT-proBNP
  </text>
  <text class="diagram-small" x="317" y="186" text-anchor="middle">
    {t['diagram.label.inactiveFragment']}
  </text>
</svg>

<style is:global>
  .diagram .peptide-release {
    animation: peptide-release 2.4s ease-in-out infinite;
  }

  @keyframes peptide-release {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.45;
    }
  }
</style>
