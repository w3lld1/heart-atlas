---
import { getMessages, type MessageKey } from '../../i18n/messages.ts';

interface Props {
  locale: string;
  /** Unique per diagram on the page; prefixes ids inside the SVG. */
  uid: string;
}

const { locale, uid } = Astro.props;
const t = getMessages(locale);
const heartId = `${uid}-hth-heart`;

// Labels are wrapped at word boundaries so that no line is longer than `max` characters.
function wrap(label: string, max: number): string[] {
  const lines: string[] = [];
  let line = '';
  for (const word of label.split(' ')) {
    if (line !== '' && line.length + 1 + word.length > max) {
      lines.push(line);
      line = word;
    } else {
      line = line === '' ? word : `${line} ${word}`;
    }
  }
  if (line !== '') lines.push(line);
  return lines;
}

const lineHeight = 15;
const lines = (key: MessageKey, max: number) => wrap(t[key], max);

// The thyroid gland on the left, an arrow of thyroid hormones to the heart on the right, and the
// heart inside the pericardium. Normal: the usual amount of hormone (a solid arrow), a heart that
// beats at its usual rhythm and only a thin layer of fluid between the heart and the outer layer
// of the pericardium. Hypothyroidism: too little hormone (a thin dashed arrow), a heart that beats
// more slowly and a wider layer of fluid labelled "may collect": an effusion is not found in
// everyone. The heart keeps its size and shape and is not compressed (tamponade is rare). The
// gland keeps its size. No numbers, no drugs, no plaques, no stiff ventricle.
const thyroid = { x: 95, y: 165 };
const gland = { dx: 22, rx: 20, ry: 36, isthmus: 10 };
const glandLabelLines = lines('diagram.label.thyroid-gland', 20);
const glandLabelY = 108 - (glandLabelLines.length - 1) * lineHeight;

// The hormone arrow and its label under it.
const arrow = 'M150,165 H282';
const arrowHead = 'M280,155 L298,165 L280,175 Z';
const thinArrowHead = 'M284,159 L296,165 L284,171 Z';
const hormoneX = 222;
const hormoneY = 196;
const usualHormoneLines = lines('diagram.label.thyroid-hormones-usual-amount', 20);
const littleHormoneLines = lines('diagram.label.too-little-thyroid-hormone', 20);

// One heart outline around (0, 0), drawn at different scales around one centre: the heart, and
// the outer layer of the pericardium close to it normally and further out with an effusion.
const centre = { x: 400, y: 165 };
const heartPath =
  'M0,82 C-65,37 -85,-18 -65,-53 C-47,-83 -13,-76 0,-53 C13,-76 47,-83 65,-53 C85,-18 65,37 0,82 Z';
const around = (scale: number) => `translate(${centre.x} ${centre.y}) scale(${scale})`;
const heartScale = 0.9;
const sacNormal = 0.97;
const sacEffusion = 1.15;
// Where a point of the outline lands at a given scale, for leader lines.
const round = (value: number) => Math.round(value * 10) / 10;
const at = (x: number, y: number, scale: number) => ({
  x: round(centre.x + x * scale),
  y: round(centre.y + y * scale),
});
// A point on the lower left of the outline (a quarter of the way along its first curve), and the
// middle of the layer of fluid there.
const lowerLeft = { x: -40.4, y: 46.8 };
const cavityNormal = at(lowerLeft.x, lowerLeft.y, (heartScale + sacNormal) / 2);
const cavityFluid = at(lowerLeft.x, lowerLeft.y, (heartScale + sacEffusion) / 2);
// The end of the upper right curve, on the outer layer.
const sacPointNormal = at(65, -53, sacNormal);
const sacPointFluid = at(65, -53, sacEffusion);
const heartPoint = at(-25, -20, heartScale);

// Labels above the heart, both anchored at their right end so that a longer translation grows
// to the left; each leader starts just under the right part of its label.
const topLabelY = 40;
const heartLabelX = 350;
const pericardiumLabelX = 512;
// The fluid label sits bottom left of the heart; its leader starts at the end of its first line.
const cavityLabelX = 330;
const cavityLabelY = 258;
const cavityLines = lines('diagram.label.pericardial-cavity', 22);
const fluidLines = lines('diagram.label.fluid-may-collect-in-pericardium', 22);
const rhythmY = 296;
const slowLines = lines('diagram.label.heart-rate-slows', 24);
---

<svg
  viewBox="0 0 520 320"
  role="img"
  aria-label={t['diagram.hypothyroid-heart-disease.title']}
  lang={locale}
>
  <defs>
    <path id={heartId} d={heartPath}></path>
  </defs>

  <!-- Thyroid gland: the same size in both states -->
  <g fill="var(--diagram-muscle)" stroke="var(--color-muted)" stroke-width="1.5">
    <rect
      x={thyroid.x - gland.dx}
      y={thyroid.y + gland.ry / 3 - gland.isthmus / 2}
      width={gland.dx * 2}
      height={gland.isthmus}
    />
    <ellipse cx={thyroid.x - gland.dx} cy={thyroid.y} rx={gland.rx} ry={gland.ry} />
    <ellipse cx={thyroid.x + gland.dx} cy={thyroid.y} rx={gland.rx} ry={gland.ry} />
  </g>

  <!-- Hormone arrow: solid normally, thin and dashed (too little hormone) in hypothyroidism -->
  <g class="normal-only" fill="var(--diagram-arterial)" stroke="var(--diagram-arterial)">
    <path d={arrow} fill="none" stroke-width="4"></path>
    <path d={arrowHead} stroke-width="1"></path>
  </g>
  <g class="disease-only" fill="var(--diagram-arterial)" stroke="var(--diagram-arterial)">
    <path d={arrow} fill="none" stroke-width="1.5" stroke-dasharray="6 6"></path>
    <path d={thinArrowHead} stroke-width="1"></path>
  </g>

  <!-- Outer layer of the pericardium and the fluid under it: thin normally, wider with effusion -->
  {[
    { state: 'normal-only', scale: sacNormal },
    { state: 'disease-only', scale: sacEffusion },
  ].map(({ state, scale }) => (
    <use
      class={state}
      href={`#${heartId}`}
      transform={around(scale)}
      fill="var(--diagram-venous-fill)"
      stroke="var(--color-muted)"
      stroke-width="3"
      vector-effect="non-scaling-stroke"
    />
  ))}

  <!-- The heart: the same size in both states; it beats more slowly in hypothyroidism -->
  {[
    { state: 'normal-only', beat: 'hth-beat' },
    { state: 'disease-only', beat: 'hth-beat hth-slow' },
  ].map(({ state, beat }) => (
    <g class={`${state} ${beat}`}>
      <use
        href={`#${heartId}`}
        transform={around(heartScale)}
        fill="var(--diagram-muscle)"
        stroke="var(--diagram-arterial)"
        stroke-width="2"
        vector-effect="non-scaling-stroke"
      />
    </g>
  ))}

  <!-- Leader lines from the labels above and below into the drawing -->
  <g stroke="var(--color-text)" stroke-width="1.5">
    <line x1={heartLabelX - 6} y1={topLabelY + 6} x2={heartPoint.x} y2={heartPoint.y}></line>
    <line
      class="normal-only"
      x1={pericardiumLabelX - 12}
      y1={topLabelY + 6}
      x2={sacPointNormal.x}
      y2={sacPointNormal.y}
    ></line>
    <line
      class="disease-only"
      x1={pericardiumLabelX - 12}
      y1={topLabelY + 6}
      x2={sacPointFluid.x}
      y2={sacPointFluid.y}
    ></line>
    <line
      class="normal-only"
      x1={cavityLabelX + 4}
      y1={cavityLabelY - 4}
      x2={cavityNormal.x}
      y2={cavityNormal.y}
    ></line>
    <line
      class="disease-only"
      x1={cavityLabelX + 4}
      y1={cavityLabelY - 4}
      x2={cavityFluid.x}
      y2={cavityFluid.y}
    ></line>
  </g>

  <!-- Labels shared by both states -->
  <text class="diagram-small" x={thyroid.x} y={glandLabelY} text-anchor="middle">
    {glandLabelLines.map((line, index) => (
      <tspan x={thyroid.x} dy={index === 0 ? 0 : lineHeight}>
        {line}
      </tspan>
    ))}
  </text>
  <text class="diagram-small" x={heartLabelX} y={topLabelY} text-anchor="end">
    {t['diagram.label.heart']}
  </text>
  <text class="diagram-small" x={pericardiumLabelX} y={topLabelY} text-anchor="end">
    {t['diagram.label.pericardium']}
  </text>

  <!-- Normal labels -->
  <g class="normal-only">
    <text class="diagram-small" x={hormoneX} y={hormoneY} text-anchor="middle">
      {usualHormoneLines.map((line, index) => (
        <tspan x={hormoneX} dy={index === 0 ? 0 : lineHeight}>
          {line}
        </tspan>
      ))}
    </text>
    <text class="diagram-small" x={cavityLabelX} y={cavityLabelY} text-anchor="end">
      {cavityLines.map((line, index) => (
        <tspan x={cavityLabelX} dy={index === 0 ? 0 : lineHeight}>
          {line}
        </tspan>
      ))}
    </text>
    <text class="diagram-small" x={centre.x} y={rhythmY} text-anchor="middle">
      {t['diagram.label.normal-rhythm']}
    </text>
  </g>

  <!-- Disease labels -->
  <g class="disease-only">
    <text class="diagram-small" x={hormoneX} y={hormoneY} text-anchor="middle">
      {littleHormoneLines.map((line, index) => (
        <tspan x={hormoneX} dy={index === 0 ? 0 : lineHeight}>
          {line}
        </tspan>
      ))}
    </text>
    <text class="diagram-small" x={cavityLabelX} y={cavityLabelY} text-anchor="end">
      {fluidLines.map((line, index) => (
        <tspan x={cavityLabelX} dy={index === 0 ? 0 : lineHeight}>
          {line}
        </tspan>
      ))}
    </text>
    <text class="diagram-small" x={centre.x} y={rhythmY} text-anchor="middle">
      {slowLines.map((line, index) => (
        <tspan x={centre.x} dy={index === 0 ? 0 : lineHeight}>
          {line}
        </tspan>
      ))}
    </text>
  </g>
</svg>

<style is:global>
  /* The heart beats inside the pericardium, more slowly in hypothyroidism; the outer layer does
     not move. Without motion the heart stands still: the arrow, the width of the fluid layer and
     the labels carry the difference. */
  .diagram .hth-beat {
    transform-box: view-box;
    transform-origin: 400px 165px;
    animation: hth-beat 1.1s ease-in-out infinite;
  }

  .diagram .hth-slow {
    animation-duration: 2s;
  }

  @keyframes hth-beat {
    0%,
    60%,
    100% {
      transform: scale(1);
    }

    25% {
      transform: scale(0.95);
    }
  }
</style>
