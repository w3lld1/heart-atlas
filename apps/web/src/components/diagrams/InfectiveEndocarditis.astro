---
import { getMessages } from '../../i18n/messages.ts';

interface Props {
  locale: string;
  /** Unique per diagram on the page; prefixes ids inside the SVG. */
  uid: string;
}

const { locale, uid } = Astro.props;
const t = getMessages(locale);
const arrowId = `${uid}-ie-arrow`;
// Blood leaving the ventricle through the open valve (normal state only).
const particles = [
  { x: 92, y: 228, delay: 0 },
  { x: 115, y: 228, delay: 0 },
  { x: 138, y: 228, delay: 0 },
  { x: 92, y: 248, delay: 0.2 },
  { x: 115, y: 248, delay: 0.2 },
  { x: 138, y: 248, delay: 0.2 },
];
// A whole leaflet, and a shorter one with a torn, jagged edge.
const leaf = 'M0,-2.5 Q22,-4 41,-2 Q45,0 41,2 Q22,4 0,2.5 Z';
const tornLeaf = 'M0,-2.5 Q14,-4 25,-2.5 L29,-5 L27,-0.5 L31,2 L25,3 Q14,4 0,2.5 Z';
---

<svg
  viewBox="0 0 400 300"
  role="img"
  aria-label={t['diagram.infective-endocarditis.title']}
  lang={locale}
>
  <defs>
    <marker
      id={arrowId}
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="var(--diagram-arterial)"></path>
    </marker>
  </defs>

  <!-- Left ventricle wall -->
  <path
    d="M70,150 C48,152 42,178 42,200 C42,258 82,292 115,292 C148,292 188,258 188,200 C188,178 182,152 160,150 Z"
    fill="var(--diagram-muscle)"
  ></path>

  <!-- Left ventricle cavity and aorta, one lumen with the valve between them -->
  <path
    d="M70,18 L70,150 C62,163 62,185 62,200 C62,245 92,272 115,272 C138,272 168,245 168,200 C168,185 168,163 160,150 L160,18 Z"
    fill="var(--diagram-arterial-fill)"
  ></path>
  <path
    d="M70,18 L70,150 C62,163 62,185 62,200 C62,245 92,272 115,272 C138,272 168,245 168,200 C168,185 168,163 160,150 L160,18"
    fill="none"
    stroke="var(--diagram-arterial)"
    stroke-width="2"
  ></path>

  <!-- Normal: blood goes one way, out of the ventricle -->
  <g class="normal-only ie-forward" fill="none" stroke="var(--diagram-arterial)" stroke-width="3">
    <path d="M92,226 L92,32" marker-end={`url(#${arrowId})`}></path>
    <path d="M115,226 L115,32" marker-end={`url(#${arrowId})`}></path>
    <path d="M138,226 L138,32" marker-end={`url(#${arrowId})`}></path>
  </g>

  <!-- Disease: blood leaks back through the gap the damaged leaflets leave -->
  <path
    class="disease-only ie-back"
    d="M122,112 C122,150 122,170 112,206"
    fill="none"
    stroke="var(--diagram-arterial)"
    stroke-width="4"
    stroke-linecap="round"
    marker-end={`url(#${arrowId})`}
  ></path>

  <!-- Disease: a fragment that has broken off the vegetation travels on with the blood -->
  <g class="disease-only">
    <path
      d="M100,92 L100,40"
      fill="none"
      stroke="var(--diagram-arterial)"
      stroke-width="3"
      stroke-dasharray="4 4"
      marker-end={`url(#${arrowId})`}
    ></path>
    <circle class="ie-veg" cx="100" cy="100" r="6"></circle>
  </g>

  <!-- Valve leaflets (side view). Normal: drawn open, the animation closes them between beats. -->
  <g class="normal-only">
    <g transform="translate(73,150) rotate(-80)">
      <g class="ie-cusp ie-cusp-normal">
        <path class="ie-leaf" d={leaf}></path>
      </g>
    </g>
    <g transform="translate(157,150) scale(-1,1) rotate(-80)">
      <g class="ie-cusp ie-cusp-normal">
        <path class="ie-leaf" d={leaf}></path>
      </g>
    </g>
  </g>
  <!-- Disease: drawn closed, so a still image shows the gap; the animation opens them. -->
  <g class="disease-only">
    <g transform="translate(73,150) rotate(-80)">
      <g class="ie-cusp ie-cusp-disease">
        <path class="ie-leaf" d={leaf}></path>
        <circle class="ie-veg" cx="14" cy="7" r="6"></circle>
        <circle class="ie-veg" cx="24" cy="7" r="5.5"></circle>
        <circle class="ie-veg" cx="7" cy="6" r="4.5"></circle>
      </g>
    </g>
    <g transform="translate(157,150) scale(-1,1) rotate(-80)">
      <g class="ie-cusp ie-cusp-disease">
        <path class="ie-leaf" d={tornLeaf}></path>
      </g>
    </g>
  </g>

  <!-- Moving blood (normal) and a breaking-off fragment (disease) -->
  <g class="flow">
    <g class="normal-only">
      {particles.map((p) => (
        <circle
          class="ie-p"
          cx={p.x}
          cy={p.y}
          r="5"
          fill="var(--diagram-arterial)"
          style={`animation-delay: ${p.delay}s`}
        />
      ))}
    </g>
    <g class="disease-only">
      <circle class="ie-veg ie-embolus" cx="86" cy="137" r="5"></circle>
    </g>
  </g>

  <!-- Labels -->
  <g stroke="var(--color-muted)" stroke-width="1.5">
    <line x1="164" y1="40" x2="194" y2="40"></line>
    <line class="disease-only" x1="108" y1="98" x2="194" y2="80"></line>
    <line class="disease-only" x1="92" y1="147" x2="194" y2="120"></line>
    <line class="disease-only" x1="148" y1="142" x2="194" y2="160"></line>
    <line class="disease-only" x1="120" y1="186" x2="194" y2="200"></line>
    <line class="normal-only" x1="157" y1="128" x2="194" y2="133"></line>
  </g>
  <text x="200" y="45">
    {t['diagram.label.aorta']}
  </text>
  <text class="disease-only" x="200" y="85">
    {t['diagram.label.embolus']}
  </text>
  <text class="disease-only" x="200" y="125">
    {t['diagram.label.vegetation']}
  </text>
  <text class="disease-only" x="200" y="165">
    {t['diagram.label.damaged-leaflet']}
  </text>
  <text class="disease-only" x="200" y="205">
    {t['diagram.label.backflow']}
  </text>
  <text class="normal-only" x="200" y="138">
    {t['diagram.label.leaflets']}
  </text>
  <text x="115" y="256" text-anchor="middle">
    {t['diagram.label.lv']}
  </text>
</svg>

<style is:global>
  .diagram .ie-leaf {
    fill: var(--color-border);
    stroke: var(--color-muted);
    stroke-width: 2;
  }

  .diagram .ie-veg {
    fill: var(--diagram-plaque);
    stroke: var(--color-muted);
    stroke-width: 1.5;
  }

  /* Closed position: a whole leaflet closes to almost level; the torn one leaves a gap. */
  .diagram .ie-cusp {
    --ie-close: 67deg;

    animation: ie-cusp 2.4s ease-in-out infinite;
  }

  /* A still disease image shows the valve closed, with the gap and the backflow through it. */
  .diagram .ie-cusp-disease {
    transform: rotate(var(--ie-close));
  }

  /* Forward flow fades while the valve is closed; backflow is strongest then but never vanishes,
     so its label always points at it. */
  .diagram .ie-forward {
    animation: ie-forward 2.4s ease-in-out infinite;
  }

  .diagram .ie-back {
    animation: ie-back 2.4s ease-in-out infinite;
  }

  .diagram .ie-p {
    opacity: 0;
    animation: ie-normal 2.4s linear infinite;
  }

  .diagram .ie-embolus {
    opacity: 0;
    animation: ie-embolus 4.8s ease-in infinite;
  }

  @keyframes ie-cusp {
    0%,
    4%,
    60%,
    100% {
      transform: rotate(var(--ie-close));
    }

    14%,
    50% {
      transform: rotate(0deg);
    }
  }

  @keyframes ie-forward {
    0%,
    4%,
    60%,
    100% {
      opacity: 0.3;
    }

    14%,
    50% {
      opacity: 1;
    }
  }

  @keyframes ie-back {
    0%,
    100% {
      opacity: 1;
    }

    10%,
    56% {
      opacity: 0.35;
    }

    66% {
      opacity: 1;
    }
  }

  @keyframes ie-normal {
    0%,
    10% {
      opacity: 0;
      transform: translate(0, 0);
    }

    14%,
    52% {
      opacity: 1;
    }

    58%,
    100% {
      opacity: 0;
      transform: translate(0, -200px);
    }
  }

  /* Every other beat a fragment breaks off the vegetation and is carried up the aorta. */
  @keyframes ie-embolus {
    0%,
    7% {
      opacity: 0;
      transform: translate(0, 0);
    }

    9% {
      opacity: 1;
      transform: translate(0, 0);
    }

    24% {
      opacity: 1;
      transform: translate(14px, -90px);
    }

    27%,
    100% {
      opacity: 0;
      transform: translate(14px, -97px);
    }
  }
</style>
