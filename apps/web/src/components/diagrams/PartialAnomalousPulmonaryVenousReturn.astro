---
import { getMessages } from '../../i18n/messages.ts';

interface Props {
  locale: string;
  /** Unique per diagram on the page; prefixes ids inside the SVG. */
  uid: string;
}

const { locale, uid } = Astro.props;
const t = getMessages(locale);
const arrowV = `${uid}-papvr-arrow-v`;
const arrowA = `${uid}-papvr-arrow-a`;
// Labels too long for one line: split each in two.
function twoLines(text: string): [string, string] {
  const words = text.split(' ');
  const split = Math.ceil(words.length / 2);
  return [words.slice(0, split).join(' '), words.slice(split).join(' ')];
}
const defectLines = twoLines(t['diagram.label.sinus-venosus-defect']);
const arteryLines = twoLines(t['diagram.label.pulmonaryArtery']);
const raLines = twoLines(t['diagram.label.ra-dilated']);
const rvLines = twoLines(t['diagram.label.rv-dilated']);
// The outline of the total anomalous return diagram: lungs on top, the body below, the right heart
// on the viewer's left and the left heart on the right.
// Normal: the four pulmonary veins bring blood from the lungs into the left atrium; the venae
// cavae bring blood from the body into the right atrium; the septum between the atria is whole.
const veinsX = [296, 312, 328, 344];
const normal = {
  ivc: 'M220,355 H60 V190 H158',
  pulmonaryArtery: 'M160,262 H120 V65 H248',
};
// Partial anomalous return, one variant: the right upper pulmonary vein (the first vein on the
// viewer's left) drains into the superior vena cava near its mouth; a sinus venosus defect high
// in the septum, by the entry of the superior vena cava, lets blood pass from left to right. The
// other three veins reach the left atrium as usual. The right atrium and ventricle are enlarged.
const papvr = {
  ivc: 'M220,355 H60 V190 H142',
  pulmonaryArtery: 'M144,262 H120 V65 H248',
  anomalousVein: `M${veinsX[0]},87 V118 H214`,
  shunt: 'M290,153 H236',
};
const otherVeinsX = veinsX.slice(1);
const svc = 'M210,15 V133';
const raToRv = 'M200,210 V224';
const laToLv = 'M320,206 V224';
const aorta = 'M340,292 V331';
const chamber = { width: 80, height: 62, rx: 10 };
---

<svg
  viewBox="0 0 520 385"
  role="img"
  aria-label={t['diagram.partial-anomalous-pulmonary-venous-return.title']}
  lang={locale}
>
  <defs>
    <marker
      id={arrowV}
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="var(--diagram-venous)"></path>
    </marker>
    <marker
      id={arrowA}
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="var(--diagram-arterial)"></path>
    </marker>
  </defs>

  <!-- Disease: the leader of the anomalous vein label runs behind the pulmonary artery -->
  <line
    class="disease-only"
    x1="228"
    y1="27"
    x2="228"
    y2="114"
    stroke="var(--color-muted)"
    stroke-width="1.5"
  ></line>

  <!-- Lungs and body -->
  <rect
    x="250"
    y="45"
    width="120"
    height="40"
    rx="20"
    fill="var(--diagram-muscle)"
    stroke="var(--color-border)"
  ></rect>
  <text x="310" y="70" text-anchor="middle">
    {t['diagram.label.lungs']}
  </text>
  <rect
    x="220"
    y="335"
    width="140"
    height="40"
    rx="20"
    fill="var(--diagram-muscle)"
    stroke="var(--color-border)"
  ></rect>
  <text x="290" y="360" text-anchor="middle">
    {t['diagram.label.body']}
  </text>

  <!-- Vessels drawn under the chambers, with arrows readable without motion -->
  <g fill="none" stroke-width="3">
    <path d={svc} stroke="var(--diagram-venous)" marker-end={`url(#${arrowV})`}></path>
    <path d={laToLv} stroke="var(--diagram-arterial)" marker-end={`url(#${arrowA})`}></path>
    <path d={aorta} stroke="var(--diagram-arterial)" marker-end={`url(#${arrowA})`}></path>
    {otherVeinsX.map((x) => (
      <path
        d={`M${x},87 V139`}
        stroke="var(--diagram-arterial)"
        stroke-width="2.5"
        marker-end={`url(#${arrowA})`}
      />
    ))}
    <g class="normal-only">
      <path d={normal.ivc} stroke="var(--diagram-venous)" marker-end={`url(#${arrowV})`}></path>
      <!-- The pulmonary artery passes over the inferior vena cava: a gap in the vein under it -->
      <path d="M120,182 V198" stroke="var(--color-bg)" stroke-width="10"></path>
      <path
        d={normal.pulmonaryArtery}
        stroke="var(--diagram-venous)"
        marker-end={`url(#${arrowV})`}
      ></path>
      <path d={raToRv} stroke="var(--diagram-venous)" marker-end={`url(#${arrowV})`}></path>
      <path
        d={`M${veinsX[0]},87 V139`}
        stroke="var(--diagram-arterial)"
        stroke-width="2.5"
        marker-end={`url(#${arrowA})`}
      ></path>
    </g>
    <g class="disease-only">
      <path d={papvr.ivc} stroke="var(--diagram-venous)" marker-end={`url(#${arrowV})`}></path>
      <path d="M120,182 V198" stroke="var(--color-bg)" stroke-width="10"></path>
      <path
        d={papvr.pulmonaryArtery}
        stroke="var(--diagram-venous)"
        marker-end={`url(#${arrowV})`}
      ></path>
      <path d={raToRv} stroke="var(--diagram-venous)" marker-end={`url(#${arrowV})`}></path>
      <!-- The right upper pulmonary vein ends in the superior vena cava, not in the left atrium -->
      <path
        d={papvr.anomalousVein}
        stroke="var(--diagram-arterial)"
        stroke-width="2.5"
        marker-end={`url(#${arrowA})`}
      ></path>
    </g>
    <!-- The superior vena cava passes over the pulmonary artery: drawn last, with a gap under it -->
    <path d="M210,57 V73" stroke="var(--color-bg)" stroke-width="10"></path>
    <path d="M210,50 V80" stroke="var(--diagram-venous)"></path>
  </g>

  <!-- Heart chambers. Disease: the right atrium and ventricle are enlarged. -->
  <g stroke-width="2">
    <g class="normal-only">
      <rect
        x="160"
        y="142"
        width={chamber.width}
        height={chamber.height}
        rx={chamber.rx}
        fill="var(--diagram-venous-fill)"
        stroke="var(--diagram-venous)"
      ></rect>
      <rect
        x="160"
        y="228"
        width={chamber.width}
        height={chamber.height}
        rx={chamber.rx}
        fill="var(--diagram-venous-fill)"
        stroke="var(--diagram-venous)"
      ></rect>
    </g>
    <g class="disease-only">
      <rect
        x="144"
        y="136"
        width="96"
        height="72"
        rx={chamber.rx}
        fill="var(--diagram-venous-fill)"
        stroke="var(--diagram-venous)"
      ></rect>
      <rect
        x="144"
        y="226"
        width="96"
        height="74"
        rx={chamber.rx}
        fill="var(--diagram-venous-fill)"
        stroke="var(--diagram-venous)"
      ></rect>
    </g>
    <rect
      x="280"
      y="142"
      width={chamber.width}
      height={chamber.height}
      rx={chamber.rx}
      fill="var(--diagram-arterial-fill)"
      stroke="var(--diagram-arterial)"
    ></rect>
    <rect
      x="280"
      y="228"
      width={chamber.width}
      height={chamber.height}
      rx={chamber.rx}
      fill="var(--diagram-arterial-fill)"
      stroke="var(--diagram-arterial)"
    ></rect>
  </g>
  <g class="normal-only">
    <text x="200" y="180" text-anchor="middle">
      {t['diagram.label.ra']}
    </text>
    <text x="200" y="266" text-anchor="middle">
      {t['diagram.label.rv']}
    </text>
  </g>
  <text x="320" y="180" text-anchor="middle">
    {t['diagram.label.la']}
  </text>
  <text x="320" y="266" text-anchor="middle">
    {t['diagram.label.lv']}
  </text>
  <g class="disease-only">
    <text class="diagram-small" x="192" y="184" text-anchor="middle">
      <tspan x="192">{raLines[0]}</tspan>
      <tspan x="192" dy="14">
        {raLines[1]}
      </tspan>
    </text>
    <text class="diagram-small" x="192" y="262" text-anchor="middle">
      <tspan x="192">{rvLines[0]}</tspan>
      <tspan x="192" dy="14">
        {rvLines[1]}
      </tspan>
    </text>
  </g>

  <!-- Disease: a sinus venosus defect high in the septum, by the entry of the superior vena cava;
       blood passes through it from left to right -->
  <g class="disease-only">
    <rect
      x="241"
      y="145"
      width="38"
      height="16"
      fill="var(--color-bg)"
      stroke="var(--color-text)"
      stroke-width="1.5"
      stroke-dasharray="3 2"
    ></rect>
    <path
      d={papvr.shunt}
      fill="none"
      stroke="var(--diagram-arterial)"
      stroke-width="3"
      marker-end={`url(#${arrowA})`}
    ></path>
    <line x1="260" y1="163" x2="260" y2="300" stroke="var(--color-muted)" stroke-width="1.5"></line>
    <text class="diagram-small" x="260" y="314" text-anchor="middle">
      <tspan x="260">{defectLines[0]}</tspan>
      <tspan x="260" dy="14">
        {defectLines[1]}
      </tspan>
    </text>
  </g>

  <!-- Moving blood -->
  <g class="flow" stroke="var(--color-bg)" stroke-width="2">
    <path class="dash-flow" d={svc}></path>
    <path class="dash-flow" d={raToRv}></path>
    <path class="dash-flow" d={laToLv}></path>
    <path class="dash-flow" d={aorta}></path>
    {otherVeinsX.map((x) => (
      <path class="dash-flow" d={`M${x},87 V139`} />
    ))}
    <g class="normal-only">
      <path class="dash-flow" d={normal.ivc}></path>
      <path class="dash-flow" d={normal.pulmonaryArtery}></path>
      <path class="dash-flow" d={`M${veinsX[0]},87 V139`}></path>
    </g>
    <g class="disease-only">
      <path class="dash-flow" d={papvr.ivc}></path>
      <path class="dash-flow" d={papvr.pulmonaryArtery}></path>
      <path class="dash-flow" d={papvr.anomalousVein}></path>
      <path class="dash-flow" d={papvr.shunt}></path>
    </g>
  </g>

  <!-- Vessel labels -->
  <text class="diagram-small" x="204" y="40" text-anchor="end">
    {t['diagram.label.svc']}
  </text>
  <text class="diagram-small" x="114" y="115" text-anchor="end">
    <tspan x="114">{arteryLines[0]}</tspan>
    <tspan x="114" dy="14">
      {arteryLines[1]}
    </tspan>
  </text>
  <text class="diagram-small" x="66" y="345">
    {t['diagram.label.ivc']}
  </text>
  <text class="diagram-small" x="358" y="104">
    {t['diagram.label.pulmonaryVeins']}
  </text>
  <text class="diagram-small" x="346" y="302">
    {t['diagram.label.aorta']}
  </text>
  <text class="diagram-small disease-only" x="222" y="22">
    {t['diagram.label.right-upper-pulmonary-vein']}
  </text>
</svg>
