---
import { getMessages } from '../../i18n/messages.ts';

interface Props {
  locale: string;
  /** Unique per diagram on the page; prefixes ids inside the SVG. */
  uid: string;
}

const { locale, uid } = Astro.props;
const t = getMessages(locale);
const arrowId = `${uid}-svt-arrow`;

/*
 * A flat pathway scheme, not a heart outline: atria on top, the AV node zoomed in the middle and
 * the ventricles below. Normal: one impulse from the SA node goes down once, in one direction.
 * Disease (typical AV nodal reentry): an early impulse goes down the slow pathway, back up the fast
 * one and keeps circling; every lap also goes down to the ventricles, so they beat fast and evenly.
 */
const loopTop = 'M220,134';
// Slow pathway: down the left side of the loop. Fast pathway: up the right side.
const slowPath = `${loopTop} C178,138 178,202 216,206`;
const fastPath = 'M220,206 C262,202 262,138 224,134';
// The whole loop as one closed path for the moving impulse (slow side first).
const loop = `${loopTop} C176,134 176,206 220,206 C264,206 264,134 220,134`;
// Normal route: SA node across the atria into the AV node, through it and down the bundle of His.
const normalRoute = 'M70,44 Q150,70 220,112 L220,262';
// Early impulse from the atria into the top of the loop.
const prematureRoute = 'M360,48 Q300,86 232,118';
---

<svg
  viewBox="0 0 440 352"
  role="img"
  aria-label={t['diagram.supraventricular-tachycardia.title']}
  lang={locale}
>
  <defs>
    <marker
      id={arrowId}
      viewBox="0 0 10 10"
      refX="7"
      refY="5"
      markerWidth="4"
      markerHeight="4"
      orient="auto-start-reverse"
    >
      <path
        d="M0,0 L10,5 L0,10 z"
        fill="var(--diagram-impulse)"
        stroke="var(--color-text)"
        stroke-width="1"
        stroke-opacity="0.6"
      ></path>
    </marker>
  </defs>

  <!-- Atria and ventricles as two bands; the AV node between them, zoomed in -->
  <rect x="16" y="16" width="408" height="84" rx="16" fill="var(--diagram-muscle)"></rect>
  <rect x="16" y="262" width="408" height="78" rx="16" fill="var(--diagram-muscle)"></rect>
  <rect
    x="140"
    y="112"
    width="160"
    height="116"
    rx="14"
    fill="var(--color-bg)"
    stroke="var(--color-border)"
    stroke-width="2"
    stroke-dasharray="6 4"
  ></rect>

  <!-- Ventricles light up on each beat: once per cycle normally, on every lap of the loop in
       tachycardia -->
  <g class="flow">
    <rect
      class="svt-beat svt-beat-normal normal-only"
      x="16"
      y="262"
      width="408"
      height="78"
      rx="16"
    ></rect>
    <rect
      class="svt-beat svt-beat-fast disease-only"
      x="16"
      y="262"
      width="408"
      height="78"
      rx="16"
    ></rect>
  </g>

  <!-- Normal: one path, one direction -->
  <g class="normal-only">
    <path class="svt-mark" d={normalRoute} marker-end={`url(#${arrowId})`}></path>
    <!-- The AV node itself: one node, one way through -->
    <ellipse class="svt-node" cx="220" cy="170" rx="16" ry="11"></ellipse>
    <g class="flow">
      <path class="svt-run svt-run-normal" d={normalRoute} pathLength="100"></path>
    </g>
  </g>

  <!-- Tachycardia: slow pathway down, fast pathway up, closed into a loop -->
  <g class="disease-only">
    <path
      class="svt-mark svt-mark-thin svt-mark-dashed"
      d={prematureRoute}
      marker-end={`url(#${arrowId})`}
    ></path>
    <path class="svt-mark svt-mark-slow" d={slowPath} marker-end={`url(#${arrowId})`}></path>
    <path class="svt-mark" d={fastPath} marker-end={`url(#${arrowId})`}></path>
    <path class="svt-mark" d="M220,210 L220,262" marker-end={`url(#${arrowId})`}></path>
    <g class="flow">
      <path class="svt-run svt-run-loop" d={loop} pathLength="100"></path>
      <path class="svt-run svt-run-down" d="M220,206 L220,262" pathLength="100"></path>
    </g>
  </g>

  <!-- Nodes -->
  <circle class="svt-node" cx="70" cy="44" r="7"></circle>
  <circle class="svt-node svt-node-early disease-only" cx="360" cy="48" r="6"></circle>

  <!-- Labels -->
  <text x="86" y="36">
    {t['diagram.label.sa-node']}
  </text>
  <text x="30" y="88">
    {t['diagram.label.atria']}
  </text>
  <text class="diagram-small disease-only" x="412" y="32" text-anchor="end">
    {t['diagram.label.premature-beat']}
  </text>
  <text x="132" y="128" text-anchor="end">
    {t['diagram.label.av-node']}
  </text>
  <text class="diagram-small disease-only" x="132" y="196" text-anchor="end">
    {t['diagram.label.slow-pathway']}
  </text>
  <text class="diagram-small disease-only" x="308" y="176">
    {t['diagram.label.fast-pathway']}
  </text>
  <text class="diagram-small" x="228" y="250">
    {t['diagram.label.his']}
  </text>
  <text x="30" y="306">
    {t['diagram.label.ventricles']}
  </text>
  <text class="diagram-small normal-only" x="412" y="306" text-anchor="end">
    {t['diagram.label.normal-rhythm']}
  </text>
  <text class="diagram-small disease-only" x="412" y="306" text-anchor="end">
    {t['diagram.label.fast-regular-rhythm']}
  </text>
</svg>

<style is:global>
  .diagram .svt-node {
    fill: var(--diagram-impulse);
    stroke: var(--color-text);
    stroke-width: 1.5;
  }

  .diagram .svt-mark {
    fill: none;
    stroke: var(--diagram-impulse);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .diagram .svt-mark-thin {
    stroke-width: 3;
  }

  /* The early impulse arrives once; the dashes set it apart from the circling loop. */
  .diagram .svt-mark-dashed {
    stroke-dasharray: 6 6;
    stroke-linecap: butt;
  }

  /* Slow pathway: dotted, so the two sides of the loop differ without motion. */
  .diagram .svt-mark-slow {
    stroke-dasharray: 2 6;
  }

  /* The moving impulse: a short dash that runs along its path (pathLength is 100). */
  .diagram .svt-run {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 8 92;
    stroke-dashoffset: 0;
    opacity: 0;
  }

  .diagram .svt-run-normal {
    animation: svt-run-normal 1.6s linear infinite;
  }

  .diagram .svt-run-loop {
    opacity: 1;
    animation: svt-run-loop 0.6s linear infinite;
  }

  .diagram .svt-run-down {
    animation: svt-run-down 0.6s linear infinite;
  }

  .diagram .svt-beat {
    fill: var(--diagram-impulse);
    opacity: 0;
  }

  .diagram .svt-beat-normal {
    animation: svt-beat-normal 1.6s linear infinite;
  }

  .diagram .svt-beat-fast {
    animation: svt-beat-fast 0.6s linear infinite;
  }

  /* Normal: the impulse runs from the SA node to the ventricles once per cycle, then a pause. */
  @keyframes svt-run-normal {
    0% {
      opacity: 1;
      stroke-dashoffset: 0;
    }

    55% {
      opacity: 1;
      stroke-dashoffset: -92;
    }

    56%,
    100% {
      opacity: 0;
      stroke-dashoffset: -92;
    }
  }

  @keyframes svt-beat-normal {
    0%,
    54% {
      opacity: 0;
    }

    58% {
      opacity: 0.45;
    }

    80%,
    100% {
      opacity: 0;
    }
  }

  /* Tachycardia: one lap of the loop every 0.6 s, without a pause. */
  @keyframes svt-run-loop {
    from {
      stroke-dashoffset: 0;
    }

    to {
      stroke-dashoffset: -100;
    }
  }

  /* At the bottom of the loop (half a lap) the impulse also goes down to the ventricles. */
  @keyframes svt-run-down {
    0%,
    49% {
      opacity: 0;
      stroke-dashoffset: 0;
    }

    50% {
      opacity: 1;
      stroke-dashoffset: 0;
    }

    90% {
      opacity: 1;
      stroke-dashoffset: -92;
    }

    91%,
    100% {
      opacity: 0;
      stroke-dashoffset: -92;
    }
  }

  @keyframes svt-beat-fast {
    0%,
    88% {
      opacity: 0;
    }

    92% {
      opacity: 0.45;
    }

    100% {
      opacity: 0.1;
    }
  }
</style>
