---
import { defaultLocale } from '../../i18n/locales.ts';
import { getMessages } from '../../i18n/messages.ts';

// A made-up teaching sample of an echocardiography report inside an article: sections of the
// sample (<ReportSection>) with terms the reader opens (<ReportTerm>). Static, no JavaScript.
// Spec: docs/plans/2026-10-14-report-explorer.md.
const { article } = Astro.locals;
if (article === undefined) throw new Error('<ReportExplorer> works only on article pages');

// UI strings are in the page language; the sample text inherits the article's (a fallback page
// shows the article in another language).
const locale = Astro.locals.locale ?? defaultLocale;
const t = getMessages(locale);
const titleId = `report-${article.slug}`;
---

<section class="report" aria-labelledby={titleId}>
  <h3 id={titleId} lang={locale}>
    {t['report.title']}
  </h3>
  <p class="report-fictional" role="note" lang={locale}>
    {t['report.fictional']}
  </p>
  <slot />
</section>

<style>
  .report {
    margin-block: 2rem;
    padding-block: 1rem;
    padding-inline: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg-2);
  }

  h3 {
    margin-block-start: 0;
  }

  .report-fictional {
    padding-block: 0.75rem;
    padding-inline: 1rem;
    border-inline-start: 4px solid var(--color-border);
    background: var(--color-notice-bg);
  }

  @media print {
    .report {
      background: none;
    }
  }
</style>
