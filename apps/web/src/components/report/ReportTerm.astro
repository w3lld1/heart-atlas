---
import { getEntry } from 'astro:content';
import { defaultLocale } from '../../i18n/locales.ts';
import { getMessages } from '../../i18n/messages.ts';
import { localePath } from '../../i18n/paths.ts';

// A line of the report sample: the parameter name with a placeholder instead of a value, and
// the article text that explains the word under a native <details>, so it works without
// JavaScript. Spec: docs/plans/2026-10-14-report-explorer.md.
interface Props {
  /** The word as a report writes it, without a value: the sample has no numbers. */
  term: string;
  /** `<type>/<slug>` of the site article that tells more, such as `disease/heart-failure`. */
  article?: string;
}

const { term, article: path } = Astro.props;
// The sample has no values (spec, constraint 3): a digit in the line would read as one.
if (/\d/.test(term)) throw new Error(`<ReportTerm term="${term}">: the sample line has no numbers`);
const locale = Astro.locals.locale ?? defaultLocale;
const t = getMessages(locale);

// The explanation repeats sentences of the article, so it keeps their sources.
const explanation = await Astro.slots.render('default');
if (!/<sup\b[^>]*\bclass="cite\b/.test(explanation)) {
  throw new Error(`<ReportTerm term="${term}">: the explanation needs at least one <Cite>`);
}

let more: { href: string; title: string } | undefined;
if (path !== undefined) {
  const { article } = Astro.locals;
  if (article === undefined) throw new Error('<ReportTerm article> works only on article pages');
  // The article in the language of this text; the link goes to the page language, as relative
  // links in the article text do.
  const id = `${article.locale}/${path}`;
  const entry = await getEntry('articles', id);
  if (entry === undefined) {
    throw new Error(`<ReportTerm term="${term}" article="${path}">: no article ${id}`);
  }
  more = {
    href: localePath(import.meta.env.BASE_URL, locale, `${path}/`),
    title: entry.data.title,
  };
}
const [moreBefore = '', moreAfter = ''] = t['report.more'].split('{title}');
// The summary and the link are inline text: line breaks inside them would render as spaces.
---

<li class="report-term">
  <details>
    <!-- prettier-ignore -->
    <summary><span class="report-name">{term}</span>: <span class="report-value" aria-hidden="true">…</span> <span class="report-placeholder" lang={locale}>({t['report.placeholder']})</span></summary>
    <div class="report-explanation" data-pagefind-ignore>
      <Fragment set:html={explanation} />
      {more && (
        <p class="report-more">
          {/* prettier-ignore */}
          <a href={more.href}>{moreBefore && <span lang={locale}>{moreBefore}</span>}{more.title}{moreAfter && <span lang={locale}>{moreAfter}</span>}</a>
        </p>
      )}
    </div>
  </details>
</li>

<style>
  .report-term {
    border-block-start: 1px solid var(--color-border);
  }

  .report-term:last-child {
    border-block-end: 1px solid var(--color-border);
  }

  summary {
    padding-block: 0.5rem;
    cursor: pointer;
  }

  summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .report-name {
    font-weight: 600;
  }

  .report-placeholder {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .report-explanation {
    padding-block-end: 0.5rem;
    padding-inline-start: 1rem;
    border-inline-start: 4px solid var(--color-border);
  }

  .report-more {
    margin-block-end: 0;
  }

  /* Print shows every explanation, closed terms too. Browsers without ::details-content print
     closed terms folded; the block adds no script for print. */
  @media print {
    /* stylelint-disable-next-line selector-pseudo-element-no-unknown -- new in Chromium 131 */
    details::details-content {
      content-visibility: visible;
    }

    summary {
      list-style: none;
    }
  }
</style>
