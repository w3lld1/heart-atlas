---
import HeartViewer from '@heart-atlas/viewer/island';
import { isDiseaseId, type DiseaseId } from '@heart-atlas/viewer';
import { defaultLocale } from '../../i18n/locales.ts';
import { getMessages } from '../../i18n/messages.ts';
import {
  heartAttribution,
  heartModelUrls,
  heartStructures,
  viewerMessages,
} from '../../lib/heart-model.ts';

interface Props {
  /** The page's locale; MDX articles leave it out and the article page provides it. */
  locale?: string;
  /** Structure ids from structures.yaml highlighted at the start. */
  highlight?: string[];
  /** Disease article id whose signs the model shows. */
  disease?: DiseaseId;
  /** 'page' beats with the heart clock on the page. */
  cycle?: 'own' | 'page';
  headingLevel?: 2 | 3 | 4;
}

const { highlight, headingLevel = 3 } = Astro.props;
// In a disease article with a shape on the model, a <HeartModel> in the text shows that shape, and
// the page leaves out its own model (docs/plans/2026-10-13-disease-picker-3d.md).
const page = Astro.locals.article;
const disease =
  Astro.props.disease ??
  (page?.type === 'disease' && isDiseaseId(page.slug) ? page.slug : undefined);
// A disease model without the page's clock gets its own heartbeat, so signs seen in motion show.
const cycle = Astro.props.cycle ?? (disease ? 'own' : undefined);
const locale = Astro.props.locale ?? Astro.locals.locale ?? defaultLocale;
const t = getMessages(locale);
const structures = heartStructures(t);
for (const id of highlight ?? []) {
  if (!structures.some((s) => s.id === id)) {
    throw new Error(`<HeartModel>: unknown structure "${id}"`);
  }
}
const { models, poster } = heartModelUrls(import.meta.env.BASE_URL);
---

<!-- <Structure> words in the article find the model by data-heart-model. -->
<div data-heart-model>
  <HeartViewer
    client:visible={{ rootMargin: '200px' }}
    models={models}
    poster={poster}
    structures={structures}
    messages={viewerMessages(t)}
    attribution={heartAttribution()}
    loadOn="click"
    headingLevel={headingLevel}
    {...(highlight ? { highlight } : {})}
    {...(disease ? { disease } : {})}
    {...(cycle ? { cycle } : {})}
  />
</div>
