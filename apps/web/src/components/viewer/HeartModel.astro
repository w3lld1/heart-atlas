---
import { HeartViewer, type DiseaseId } from '@heart-atlas/viewer';
import { defaultLocale } from '../../i18n/locales.ts';
import { getMessages } from '../../i18n/messages.ts';
import {
  heartAttribution,
  heartModelUrls,
  heartStructures,
  viewerMessages,
} from '../../lib/heart-model.ts';

interface Props {
  /** The page's locale; MDX articles leave it out and the article page provides it. */
  locale?: string;
  /** Structure ids from structures.yaml highlighted at the start. */
  highlight?: string[];
  /** Disease article id whose signs the model shows. */
  disease?: DiseaseId;
  /** 'page' beats with the heart clock on the page. */
  cycle?: 'own' | 'page';
  headingLevel?: 2 | 3 | 4;
}

const { highlight, disease, cycle, headingLevel = 3 } = Astro.props;
const locale = Astro.props.locale ?? Astro.locals.locale ?? defaultLocale;
const t = getMessages(locale);
const structures = heartStructures(t);
for (const id of highlight ?? []) {
  if (!structures.some((s) => s.id === id)) {
    throw new Error(`<HeartModel>: unknown structure "${id}"`);
  }
}
const { models, poster } = heartModelUrls(import.meta.env.BASE_URL);
---

<HeartViewer
  client:visible={{ rootMargin: '200px' }}
  models={models}
  poster={poster}
  structures={structures}
  messages={viewerMessages(t)}
  attribution={heartAttribution()}
  loadOn="click"
  headingLevel={headingLevel}
  {...(highlight ? { highlight } : {})}
  {...(disease ? { disease } : {})}
  {...(cycle ? { cycle } : {})}
/>
