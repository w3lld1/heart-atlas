---
import { getMessages } from '../i18n/messages.ts';
import { localePath } from '../i18n/paths.ts';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getMessages(locale);
// A plain form without JavaScript: the search page loads Pagefind only when it is needed.
---

<form
  role="search"
  aria-label={t['search.label']}
  action={localePath(import.meta.env.BASE_URL, locale, 'search/')}
  method="get"
>
  <label for="site-search">{t['search.label']}</label>
  <span class="field">
    <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="6.75" cy="6.75" r="4.75"></circle>
      <path d="M10.25 10.25 14 14"></path>
    </svg>
    <input id="site-search" type="search" name="q" required placeholder={t['search.placeholder']} />
  </span>
  <button type="submit">{t['search.submit']}</button>
</form>

<style>
  form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  label {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .field {
    position: relative;
    display: flex;
    flex: 1 1 12rem;
  }

  .icon {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0.625rem;
    inline-size: 1rem;
    block-size: 1rem;
    translate: 0 -50%;
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.75;
    stroke-linecap: round;
    pointer-events: none;
  }

  input::placeholder {
    color: var(--color-muted);
  }

  input,
  button {
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }

  /* Room for the magnifier at the start of the field. */
  input {
    flex: 1;
    min-inline-size: 0;
    padding-inline-start: 2.125rem;

    /* Muted, not the border colour: the field outline needs 3:1 against the page. */
    border-color: var(--color-muted);
  }
</style>
