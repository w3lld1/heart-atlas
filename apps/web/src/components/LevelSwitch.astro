---
import { getMessages } from '../i18n/messages.ts';

interface Props {
  locale: string;
}

const t = getMessages(Astro.props.locale);
const levels = ['patient', 'student'] as const;
---

<div class="level-switch" data-pagefind-ignore>
  <div class="level-buttons">
    <span id="level-switch-label" class="level-switch-label">
      {t['level.label']}
    </span>
    <div class="level-options" role="group" aria-labelledby="level-switch-label">
      {levels.map((level) => (
        <button type="button" data-set-level={level} aria-pressed="false">
          {t[`level.${level}`]}
        </button>
      ))}
    </div>
  </div>
  {/* Says what the chosen level changes; the article text below swaps without other notice. */}
  {levels.map((level) => (
    <p class="level-hint" data-hint={level}>
      {t[`level.${level}.hint`]}
    </p>
  ))}
</div>

<script>
  const key = 'heart-atlas:level';
  const root = document.documentElement;

  function show(level: string) {
    root.dataset['level'] = level;
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-set-level]')) {
      button.setAttribute('aria-pressed', String(button.dataset['setLevel'] === level));
    }
  }

  show(root.dataset['level'] ?? 'patient');
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-set-level]')) {
    button.addEventListener('click', () => {
      const level = button.dataset['setLevel'] ?? 'patient';
      show(level);
      try {
        localStorage.setItem(key, level);
      } catch {
        // Storage can be blocked; the choice then lasts until the page closes.
      }
    });
  }
</script>

<style>
  .level-switch {
    display: none;
    margin-block: 1rem;
  }

  :global(html[data-level]) .level-switch {
    display: block;
  }

  .level-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  /* The two buttons wrap as one, so on a narrow screen the label sits on its own line. */
  .level-options {
    display: flex;
    gap: 0.5rem;
  }

  .level-switch-label {
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .level-hint {
    margin-block: 0.5rem 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  :global(html[data-level='patient']) .level-hint[data-hint='student'],
  :global(html[data-level='student']) .level-hint[data-hint='patient'] {
    display: none;
  }

  button {
    padding-block: 0.375rem;
    padding-inline: 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }

  button[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
