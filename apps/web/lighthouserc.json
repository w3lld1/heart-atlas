{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec astro preview --port 4321 --ignore-lock",
      "startServerReadyPattern": "localhost:4321",
      "url": [
        "http://localhost:4321/heart-atlas/ru/",
        "http://localhost:4321/heart-atlas/en/",
        "http://localhost:4321/heart-atlas/ru/disease/atrial-fibrillation/",
        "http://localhost:4321/heart-atlas/en/disease/heart-failure/",
        "http://localhost:4321/heart-atlas/ru/anatomy/",
        "http://localhost:4321/heart-atlas/ru/heart-clock/",
        "http://localhost:4321/heart-atlas/ru/heart-sounds/",
        "http://localhost:4321/heart-atlas/ru/search/?q=%D1%81%D0%B5%D1%80%D0%B4%D1%86%D0%B5",
        "http://localhost:4321/heart-atlas/ru/embed/",
        "http://localhost:4321/heart-atlas/en/embed/ecg/",
        "http://localhost:4321/heart-atlas/en/embed/disease/hypertension/",
        "http://localhost:4321/heart-atlas/en/embed/heart-model/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/embed/[^/?]+/).*$",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/embed/[^/?]+/",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
