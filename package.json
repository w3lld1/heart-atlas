{
  "name": "heart-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @heart-atlas/web dev",
    "build": "pnpm --filter @heart-atlas/web build",
    "preview": "pnpm --filter @heart-atlas/web preview",
    "lint": "eslint . && prettier --check . && stylelint \"**/*.{css,astro}\" --allow-empty-input",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "i18n:check": "pnpm --filter @heart-atlas/web i18n:check",
    "test": "vitest run",
    "e2e": "pnpm --filter @heart-atlas/web e2e",
    "lhci": "pnpm --filter @heart-atlas/web lhci"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
